		<tr>
			<td style="width:15%" class="left_title">Short Description :</td>
			<td style="width:85%">
				<?php $onchange = ('' == $data1['news_id']) ? 'javascript: updateTags();' : ''?>
				<?php $desc     = ('' == $data1['short_description']) ? '' : str_replace('<', '&lt;', str_replace('<br />', '', $data1['short_description']))?>
