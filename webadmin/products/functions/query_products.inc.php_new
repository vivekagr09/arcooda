if (!function_exists('productCount')) {
    function productCount($where = "1")
    {
        global $DB;

        if (is_array($where)) {
            $where = productQuery($where);
        }

        if ($row = $DB->query_first(sprintf(
            "SELECT COUNT(*) AS `total` FROM `products` WHERE %s LIMIT 1",
