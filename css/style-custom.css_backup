.badge:empty {
    display: none;
}
.btn .badge {
    position: relative;
    top: -1px;
}
.btn-group-xs > .btn .badge,
.btn-xs .badge {
    top: 0;
    padding: 1px 5px;
}
a.badge:focus,
a.badge:hover {
    color: #fff;
    text-decoration: none;
    cursor: pointer;
}
