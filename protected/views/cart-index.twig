        $('#change_shipper_id').change(function(){
            $('#change_freight_country').submit();
        })
        $('.proceed-to-checkout').click(function(){
          if($('#cart_type').val()=='quote'){
            $('#checkout_form').attr('action', '/quote-checkout');
            $('#action_order').val('submit_order');
          }else{
            $('#checkout_form').attr('action', '/checkout');
          }
            $('#checkout_form').submit();
        });
        $('.change_freight_show').click(function(e){
            e.preventDefault();
            if($('.hide-address-class').hasClass('hide-address')){
              $('.hide-address-class').removeClass('hide-address');
            }
        });

        $('#submit_inquiry').click(function(){
            var comment = $('#quote_request_comment').val();
            $('#inquiry_comment').val(comment);
        });
    }, false);
    //]]>
     $("[name='checkout[ship_number]']").change(function(e) {
         if($(this).val() == 'own_0'){
            $("[name='checkout[own_account_num]']").val($(this).data('account_num'));
            $("[name='checkout[own_courier_name]']").val($(this).data('courier_name'));
            $("[name='checkout[own_courier_id]']").val($(this).data('courier_id'));
        }
        e.preventDefault();
    });
    function quote_request()
    {
      var comment = $('#quote_request_comment').val();
      var url = '/cart/assisted-checkout?type=quote&comment='+comment;
      window.open(url, 'assisted-checkout', 'width=576,height=600,resizable,scrollbars');
    }
