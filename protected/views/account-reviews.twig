</div></div></div>
<script type="text/javascript">
     var productNumber = 0
     Dropzone.autoDiscover = false;
        $(function() {

        $('.reviewPopup').on('click', function (){
                $('#product_name').html('');
                var productNumber = parseInt($(this).data('id'));
                var productName = $(this).data('name');
                $('#review_product_id').val(productNumber);
                $('#attached-filedata').html('<div id="attached-file-'+productNumber+'"></div>')
                $('#product_name').append('<span style="background-color: yellow;">'+productName+'</span>');
               var myDropzone = new Dropzone("#my-dropzone", {
                url: '/contact/review_attachment.php?id=' + productNumber,
                maxFilesize: 2, // Maximum file size in MB
                acceptedFiles: 'image/*', // Accept only images
                addRemoveLinks: true, // Allow file removal
                dictRemoveFile: "Remove", // Customize the remove link text
                autoProcessQueue: false, // Disable automatic upload on file selection
                parallelUploads: 5, // Allow multiple files to be uploaded at once
                uploadMultiple: true,
                init: function() {
                    var dropzoneInstance = this;

                    // Handling form submission
                    $('#dashboardReview').on('submit', function(e) {  
                        e.preventDefault();
                        dropzoneInstance.off("success");
                        console.log(dropzoneInstance.getQueuedFiles().length);
                         // Check if there are files in the Dropzone queue
                        if (dropzoneInstance.getQueuedFiles().length === 0) {
                            // If no files are queued, directly submit the form
                             $('#dashboardReview').off('submit').submit(); // Use 'this' to reference the form
                            return; // Exit the function
                        }
                        dropzoneInstance.on("success", function(file, responseArray) {
                            JSON.parse(responseArray).forEach(function(response) {
                                $('#attached-file-'+productNumber).append('<input type="hidden" name="attachments[]" value="'+response+'">');
                            });
                        });
                        dropzoneInstance.on('queuecomplete', function() {
                             $('#dashboardReview').off('submit').submit();
                        });
                        dropzoneInstance.processQueue();
                    });
                }
            });
        })

       $('.editReview').on('click', function(){
            //$('#dashboardReview').find('input, textarea').val('');
                var product_id = $(this).data('id'); 
                var elementId =  document.getElementById('my-dropzone-'+product_id);
                if(elementId && elementId.dropzone){
                     //elementId.dropzone.destroy();
                }
                var myDropzone = new Dropzone("#my-dropzone-"+product_id, {
                url: '/contact/review_attachment.php?id=' + product_id,
                maxFilesize: 2, // Maximum file size in MB
                acceptedFiles: 'image/*', // Accept only images
                addRemoveLinks: true, // Allow file removal
                dictRemoveFile: "Remove", // Customize the remove link text
                autoProcessQueue: false, // Disable automatic upload on file selection
                parallelUploads: 5, // Allow multiple files to be uploaded at once
                uploadMultiple: true,
                init: function() {

                    var dropzoneInstance = this;

                    // Preload already uploaded images
                    var uploadedImages = Object.values(JSON.parse($('#product-image-'+product_id).val()));
                    uploadedImages.forEach(function(image) {
                        // Create the mock file
                        var mockFile = {id:image.id ,name: image.name, size: image.size };

                        // Add the mock file to the Dropzone
                        dropzoneInstance.emit("addedfile", mockFile);

                        // Set the file thumbnail (the second argument is the URL of the thumbnail)
                        dropzoneInstance.emit("thumbnail", mockFile, image.url);

                        // Mark the file as complete
                        dropzoneInstance.emit("complete", mockFile);

                        // Optionally add a remove link for each file
                        dropzoneInstance.files.push(mockFile); // Add to Dropzone's files array
                    });
                    /** $('#dashboardReview'+product_id).on('submit', function(e) {
                        console.log('asd');
                        e.preventDefault();
                        
                        // Clear any existing listeners to prevent duplicates
                        dropzoneInstance.off("success");
                        
                        dropzoneInstance.on("success", function(file, responseArray) {
                            console.log(responseArray); 
                            JSON.parse(responseArray).forEach(function(response) {
                               $('#attached-file-'+product_id).append('<input type="hidden" name="attachments[]" value="'+response+'">');
                            });
                        });

                        dropzoneInstance.on('queuecomplete', function() {
                               $('#dashboardReview' + product_id).off('submit').submit();
                        });

                         // Start processing the Dropzone queue
                         dropzoneInstance.processQueue();
                    }); **/
                    $('#dashboardReview' + product_id).on('submit', function(e) {
                        e.preventDefault();

                        // Clear any existing listeners to prevent duplicates
                        dropzoneInstance.off("success");
                        if (dropzoneInstance.getQueuedFiles().length === 0) {
                            // If no files are queued, directly submit the form
                             $('#dashboardReview' + product_id).off('submit').submit(); // Use 'this' to reference the form
                            return; // Exit the function
                        } 
                        // Check if there are files in the Dropzone queue
                        if (dropzoneInstance.getQueuedFiles().length > 0) {
                            console.log('Files are in the queue, processing dropzone...');
                            
                            // Listen for success event after file upload
                            dropzoneInstance.on("success", function(file, responseArray) {
                                console.log(responseArray);
                                JSON.parse(responseArray).forEach(function(response) {
                                    $('#attached-file-' + product_id).append('<input type="hidden" name="attachments[]" value="' + response + '">');
                                });
                            });

                            // Once the queue is complete, submit the form
                            dropzoneInstance.on('queuecomplete', function() {
                                $('#dashboardReview' + product_id).off('submit').submit();  // Remove the event handler and submit the form
                            });

                            // Start processing the Dropzone queue
                            dropzoneInstance.processQueue();
                        } else {
                            // If no files, submit the form directly
                            $('#dashboardReview' + product_id).off('submit').submit();
                        }
                    });

                    // Event triggered when a file is removed
                    this.on("removedfile", function(file) {
                        if(file.id){
                             $('#removed-file-'+product_id).append('<input type="hidden" name="attachmentsremoved[]" value="'+file.id+'">');
                        }
                        // Optionally handle the file removal on the server-side
                    });
                }
            });
        });

        // Listen for click event on the 'viewReview' class
        $('.viewReview').on('click', function(e) {
            e.preventDefault(); // Prevent default anchor behavior

            // Get the review ID from the clicked element
            var reviewId = $(this).data('reviewid');

            // Toggle the corresponding review row's visibility
            $('#viewReview_' + reviewId).toggle();
        });


    });
</script>
{% endblock %}
