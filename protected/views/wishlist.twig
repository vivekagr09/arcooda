{#
// inputs:
// - page_title:
// - page_description:
// - page_keywords:
// - page_canonical:
// - page_breadcrumbs:
// - error:
// - success:
// - tab:
// - updated:
#}

{% set global_page_title       = inputs.page_title %}
{% set global_page_description = inputs.page_description %}
{% set global_page_keywords    = inputs.page_keywords %}
{% set global_page_canonical   = inputs.page_canonical %}
{% set global_page_breadcrumbs = inputs.page_breadcrumbs %}

{% set products   = inputs.products                                        %}

{% extends '/layouts/default.twig' %}

{% block site_body %}
    <div class="site__body">
    {% include '/blocks/block-header.twig' with {inputs: {
        breadcrumb: global_page_breadcrumbs,
        cart_items: [],
        title: global_page_title
    }} %}
      <div class="block">
         <div class="container container-xl">
            <div class="wishlist">
              {% if products | length > 0 %}
               <table class="wishlist__table">
                  <thead class="wishlist__head">
                     <tr class="wishlist__row wishlist__row--head">
                        <th class="wishlist__column wishlist__column--head wishlist__column--image">Image</th>
                        <th class="wishlist__column wishlist__column--head wishlist__column--product">Product</th>
                        <th class="wishlist__column wishlist__column--head wishlist__column--stock">Stock status</th>
                        <th class="wishlist__column wishlist__column--head wishlist__column--price">Price</th>
                        <th class="wishlist__column wishlist__column--head wishlist__column--button"></th>
                        <th class="wishlist__column wishlist__column--head wishlist__column--remove"></th>
                     </tr>
                  </thead>
                  <tbody class="wishlist__body">
                    {% for product in products %}
                     <tr class="wishlist__row wishlist__row--body">
                        <td class="wishlist__column wishlist__column--body wishlist__column--image">
                          <a href="{{ product.url|e }}">
                            <img src="{{ image(product.images[0], {size: 50}) }}" width="50">
                          </a>
                        </td>
                        <td class="wishlist__column wishlist__column--body wishlist__column--product">
                           <div class="wishlist__product-name">
                              <a href="{{ product.url|e }}">{{ product.name|e }}</a>
                           </div>

                        </td>
                        <td class="wishlist__column wishlist__column--body wishlist__column--stock">
                          {% if product.availability in ['In Stock', 'Stock'] %}
                            <div class="status-badge status-badge--style--success status-badge--has-text">
                               <div class="status-badge__body">
                                  <div class="status-badge__text">{{ product.availability|e }}</div>
                               </div>
                            </div>
                            {% else %}
                            <div class="status-badge status-badge--style--danger status-badge--has-text">
                               <div class="status-badge__body">
                                  <div class="status-badge__text">{{ product.availability|e }}</div>
                               </div>
                            </div>
                            {% endif %}
                        </td>
                        <td class="wishlist__column wishlist__column--body wishlist__column--price">
                           {{ product.price }}
                        </td>
                        <td class="wishlist__column wishlist__column--body wishlist__column--button">
                            <form action="{{ product.url|e }}" method="post">
                              <input  name="product_qty" type="hidden"  value="1" />
                              <input type="hidden" name="product_name" value="{{ product.name|e }}" />
                              <input type="hidden" name="product_id" value="{{ product.id|e }}" />
                              <input type="hidden" name="product_price" value="{{ product.priceValue|e }}" />
                              <input type="hidden" name="product_img" value="{{ product.images[0]|e }}" />
                              <input type="hidden" name="product_url" value="{{ product.url|e }}" />
                              <button type="submit" class="btn btn-sm btn-primary">Add to cart</button>
                            </form>
                        </td>
                        <td class="wishlist__column wishlist__column--body wishlist__column--remove">
                          <a href="/p/removewishlist/{{product.encryptid}}">
                           <button type="button" class="wishlist__remove btn btn-sm btn-muted btn-icon">
                             <img src="/svg/cross-12.svg" style="vertical-align:top;" width="12" height="12">
                           </button>
                         </a>
                        </td>
                     </tr>
                   {% endfor %}
                  </tbody>
               </table>
               {% else %}
                <div style="text-align: center; padding: 10px; font-size: 16px;">
                  <div>
                    <img src="/svg/wishlist-16.svg" style="vertical-align:top;" width="16" height="16">
                    <span style="padding: 5px;"> Add to wishlist,</span>

                  <span>Please use the "Add to wishlist" in the product section for wishlist products .</span>
                 </div>
                </div>
                {% endif %}
            </div>
        </div>
      </div>

    <div class="block-space block-space--layout--before-footer"></div>
  </div>
{% endblock %}
