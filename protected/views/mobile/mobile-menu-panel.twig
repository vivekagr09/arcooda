{#
// inputs:
// - panel: data object
#}
{% set cart = cart() %}
{% set panel = inputs.panel %}
{% set comcount = comWisCount() %}
{% set allow_inquiry = allowInquirySectionOnMobile() %}
{% set root_classes = classnames('mobile-menu__panel', {
    'mobile-menu__panel--hidden': not panel.root
}) %}

<div class="{{ root_classes }}">
    <div class="mobile-menu__panel-header">
        {% if not panel.root %}
            <button class="mobile-menu__panel-back" type="button">
                {{ svg_inline('arrow-rounded-left-7x11.svg') }}
            </button>
        {% endif %}
        <div class="mobile-menu__panel-title">{{ panel.title }}</div>
    </div>
    <div class="mobile-menu__panel-body">
        {% for item in panel.items %}
            {% if item.type == 'divider' %}
                <div class="mobile-menu__divider"></div>
            {% elseif item.type == 'spring' %}
            <div class="mobile-menu__spring"></div>
            {% elseif item.type == 'settings' %}
                <div class="mobile-menu__settings-list">
                    {% for item in item.items %}
                        <div class="mobile-menu__setting" data-mobile-menu-item>
                            <button class="mobile-menu__setting-button hide_contact_inquiry" title="{{ item.title }}" data-mobile-menu-trigger>
                                <span class="{{ classnames('mobile-menu__setting-icon', {'mobile-menu__setting-icon--currency': item.type == 'currency'}) }}">
                                    {% if item.type == 'currency' %}
                                        {{ item.value }}
                                    {% elseif item.type == 'language' %}
                                        <img src="{{ item.value }}" alt="" />
                                    {% endif %}
                                </span>
                                <span class="mobile-menu__setting-title">{{ item.label }}</span>
                                <span class="mobile-menu__setting-arrow">{{ svg_inline('arrow-rounded-right-6x9.svg') }}</span>
                            </button>
                            {% if item.panel %}
                                <div class="mobile-menu__setting-panel" data-mobile-menu-panel>
                                    {% include '/mobile/mobile-menu-panel.twig' with {inputs: {
                                        panel: item.panel,
                                    }} %}
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% elseif item.type == 'indicators' %}
                <div class="mobile-menu__indicators">
                    {% for item in item.items %}
                        <a class="mobile-menu__indicator" href="{{ item.url }}">
                            <span class="mobile-menu__indicator-icon">
                                <img src="/svg/{{ item.icon|e }}" width="20px;" />
                                {% if item.counter %}
                                    {% if item.title=='Wishlist'%}
                                    <span class="mobile-menu__indicator-counter compare">{{ comcount.wishlist }}</span>
                                    {% elseif item.title == 'Compare' %}
                                    <span class="mobile-menu__indicator-counter compare">{{ comcount.compare }}</span>
                                    {% elseif item.title == 'Cart' %}
                                    <span class="mobile-indicator__counter">{{ cart.items | length }}</span>
                                    {% else %}
                                    <span class="mobile-menu__indicator-counter">{{ item.counter }}</span>
                                    {% endif %}
                                {% endif %}
                            </span>
                            <span class="mobile-menu__indicator-title">{{ item.title }}</span>
                        </a>
                    {% endfor %}
                </div>
            {% elseif item.type == 'links' %}
                <ul class="mobile-menu__links">
                    {% for item in item.items %}
                        <li data-mobile-menu-item>
                            {% set content %}
                                {% if item.image %}
                                    <div class="mobile-menu__links-image">
                                        <img src="{{ item.image|e }}" alt="{{ item.image.alt|e }}" />
                                    </div>
                                {% endif %}
                                {{ item.title }}
                                {% if item.panel %}
                                    {{ svg_inline('arrow-rounded-right-7x11.svg') }}
                                {% endif %}
                            {% endset %}
                            {% set classes = classnames({'highlight': item.highlight}) %}

                            {% if item.url %}
                                <a href="{{ item.url }}" class="{{ classes }}hide_contact_inquiry"{% if item.external %} target="_blank"{% endif %} data-mobile-menu-trigger>{{ content }}</a>
                            {% else %}
                                <button type="button" class="{{ classes }}hide_contact_inquiry" data-mobile-menu-trigger>{{ content }}</button>
                            {% endif %}

                            {% if item.panel %}
                                <div class="mobile-menu__links-panel" data-mobile-menu-panel>
                                    {% include '/mobile/mobile-menu-panel.twig' with {inputs: {
                                        panel: item.panel,
                                    }} %}
                                </div>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>

               {% if allow_inquiry==1 %}
               <div class="mobile-contact-inquiry">
                    <div class="mobile-menu__divider"></div>
                   <a class="mobile-menu__contacts">
                         <div style="text-align: center; padding-top: 15px; "><button class="btn btn-success btn-lg btn-block" type="button" onclick="window.location.href='/inquiry';" style="">Send Inquiry</button></div>
                    </a>
                </div>    
                {% endif %}
           {% endif %}
        {% endfor %}
        
    </div>
</div>
<script type="text/javascript">
    $('.hide_contact_inquiry').click(function(){
        $('.mobile-contact-inquiry').hide(); 
    });
    $('.mobile-menu__panel-back').click(function(){
        $('.mobile-contact-inquiry').show(); 
    });
</script>
