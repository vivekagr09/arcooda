  <script type="text/javascript">
document.addEventListener('DOMContentLoaded', function () {
  const table = document.querySelector('.compare__table');
  const rows = Array.from(table.querySelectorAll('tr'));

  let dragStartIndex = null;

  // make only product columns draggable
  rows.forEach(row => {
    const cols = row.querySelectorAll('.compare-table__column--product');
    cols.forEach((col, index) => {
      col.setAttribute('draggable', true);

      col.addEventListener('dragstart', e => {
        dragStartIndex = index;
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', index);
      });

      col.addEventListener('dragover', e => {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'move';
        col.style.outline = '2px dashed #4CAF50';
      });

      col.addEventListener('dragleave', () => {
        col.style.outline = '';
      });

      col.addEventListener('drop', e => {
        e.preventDefault();
        col.style.outline = '';

        const dragEndIndex = Array.from(col.parentElement.children)
          .filter(c => c.classList.contains('compare-table__column--product'))
          .indexOf(col);

        if (dragStartIndex === dragEndIndex) return;

        // Swap columns for all rows
        rows.forEach(r => {
          const cells = Array.from(r.querySelectorAll('.compare-table__column--product'));
          if (cells[dragStartIndex] && cells[dragEndIndex]) {
            if (dragStartIndex < dragEndIndex) {
              cells[dragEndIndex].after(cells[dragStartIndex]);
            } else {
              cells[dragEndIndex].before(cells[dragStartIndex]);
            }
          }
        });
      });
    });
  });
});
document.addEventListener("change", function (e) {
  if (e.target.classList.contains("remove-col")) {
    const colIndex = parseInt(e.target.dataset.col);
    const table = document.querySelector(".compare-table");

    // Toggle show/hide for that column
    for (const row of table.rows) {
      if (row.cells[colIndex]) {
        row.cells[colIndex].style.display = e.target.checked ? "none" : "";
      }
    }
  }
});
function printTable() {
    const table = document.getElementById("printTable").outerHTML;

    const newWindow = window.open("", "", "width=900,height=700");
    newWindow.document.write(`
        <html>
        <head>
            <title>Print Table</title>
            <style>
                table {
                    width: 100%;
                    border-collapse: collapse;
                }
                th, td {
                    border: 1px solid #000;
                    padding: 8px;
                }
                 @media print {
                    .fa, .fas, .far, .fal, .fab,.svg-inline--fa {
                        display: none !important;
                    }
                }
            </style>
        </head>
        <body>${table}</body>
        </html>
    `);

    newWindow.document.close();
    newWindow.focus();
    newWindow.print();
    newWindow.close();
}
</script>
{% endblock %}

