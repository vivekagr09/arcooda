                                        <option value="size" {{sortby == 'size' ? 'selected' : ''}}>Monitor Size</option>
                                        <option value="ratio" {{sortby == 'ratio' ? 'selected' : ''}}>Aspect Ratio</option>
                                        <option value="name" {{sortby == 'name' ? 'selected' : ''}}>Name</option>
                                    </select>
