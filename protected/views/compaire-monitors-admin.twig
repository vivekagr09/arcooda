{#
// inputs:
// - page_title:
// - page_description:
// - page_keywords:
// - page_canonical:
// - page_breadcrumbs:
// - error:
// - success:
// - tab:
// - updated:
#}

{% set global_page_title       = inputs.page_title %}
{% set global_page_description = inputs.page_description %}
{% set global_page_keywords    = inputs.page_keywords %}
{% set global_page_canonical   = inputs.page_canonical %}
{% set global_page_breadcrumbs = inputs.page_breadcrumbs %}

{% set products   = inputs.products %}
{% set helpText = inputs.helpText %}
{% set sortby = inputs.sortby %}
{% extends '/layouts/default-without-header.twig' %}

{% block site_body %}
    <style type="text/css">
        .table-background-colour {
            background-color: #f2f2f2 !important;
        }
        .compare-table__column--header, .compare-table__column--product {
            padding: 5px 5px;
        }
        .compare-table__column--header {
            min-width: 250px;
        }
        .spec__name {
            padding-right: 1px !important; 
        }
        .col-6-value{
                margin-left: 12px;
        }
        .compare-table__column--product {
            min-width: 200px!important;
        }
        .spec__row{
            border: none !important;
        }
      .table-responsive {
  display: block;
  width: 100%;
  overflow-x: auto;
  overflow-y: auto;
  position: relative;
  -webkit-overflow-scrolling: touch;
}

/* Sticky first column (left side) */
.compare-table th:first-child,
.compare-table td:first-child {
  position: sticky;
  left: 0;
  background: #f8f8f8;
  z-index: 3; /* slightly lower than header row */
}

/* Sticky first row (for rotated table) */
/* Wrap your table for scrolling */
.table-sticky-wrapper {
    max-height: 500px;         /* adjust height */
    overflow: auto;
    position: relative;
}

/* Sticky first row */
.table-sticky-wrapper table thead th {
    position: sticky;
    top: 0;
    background: #fff;          /* required */
    z-index: 10;
}

/* Sticky first column */
.table-sticky-wrapper table th:first-child,
.table-sticky-wrapper table td:first-child {
    position: sticky;
    left: 0;
    background: #fff;          /* required */
    z-index: 5;
}

/* Fix overlap where header & first column meet */
.table-sticky-wrapper table thead th:first-child {
    z-index: 20;
}
</style>
