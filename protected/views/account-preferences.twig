{#
// inputs:
// - title:
// - description:
// - keywords:
// - addresses:
// - member:
// - orders:
#}

{% set global_page_title           = inputs.title|default('')                     %}
{% set global_page_description     = inputs.description|default('')               %}
{% set global_page_keywords        = input.keywords|default('')                   %}
{% set global_page_canonical       = '/account/preferences'                         %}
{% set global_page_breadcrumbs     = [
    {title : 'Home',            url : '/'                  },
    {title : global_page_title, url : global_page_canonical},
] %}
{% set global_current_account_page = global_page_canonical                        %}

{% set member    = inputs.member                                                  %}

{% set member_preferences    = inputs.member_preferences  %}
{% set alert     = inputs.alert                                                   %}
{% set issues    = inputs.issues                                                  %}
{% set result    = inputs.result                                                  %}
{% extends '/layouts/account.twig' %}
{% set currency_list = inputs.currency_list %}
{% set membercurrency = inputs.membercurrency %}


{% block account_body %}

    <style>
    .toltipicon{
        position: absolute;
    right: -24px;
    top: 10px;

    }
    </style>
    {% if result %}<div class="alert alert-{{ result }}" role="alert">{{ alert|e }}</div>{% endif %}
     <div class="card-header">
            <h5 class="content_heading_color">Site/Order Preferences</h5>
    </div>
    <div class="card-divider"></div>
    <div class="card-body card-body--padding--2">
    <form action="" method="post">
        <div class="row">

           <div class="col-lg-6 form-group form-row field-b_transactioncurrency">
                  <div class="col-sm-5 col-md-4 col-lg-3 col-xl-5 col-xxl-4 col-form-label"><label for="b_transactioncurrency">Default Currency</label></div>
                  <div class="col-sm-7 col-md-8 col-lg-9 col-xl-7 col-xxl-8">
                     <select id="b_transactioncurrency" class="form-control" name="b_transactionCurrency" autocomplete="section-register billing transaction-currency">
                         {% for  currency in currency_list %}
                           <option value="{{currency.code}}" {{(membercurrency==currency.code)?'selected':''}}>{{currency.code}} - {{currency.name}}</option>
                        {% endfor %}
                     </select>
                     <div class="invalid-feedback-- "><i data-HTML="true" class="toltipicon far fa-question-circle" data-toggle="tooltip" data-placement="top" title="" data-original-title="<b>Default Currency</b><br>
<p>Arcooda only issues invoices in USD or AUD (with GST tax), however, we can offer approximate costs in your currency (please mouse over the ($) icon near the sell price to view the approximate price in your currency).</p>"></i></div>
                  </div>
               </div>
             </div>

        <div class="col-lg-12">
            <div class="form-group">

                <input type="checkbox" name="newslater" {{ (member.mailing_list   == 'y') ? 'checked' : '' }}/> Newsletter
            </div>
        </div>
        <div class="col-lg-12">
            <div class="form-group">

                <input type="checkbox" name="special_freight" {{ (member.special_freight_needs   == 'y') ? 'checked' : '' }} id="special_freight"/> Special Freights Needs
            </div>
        </div>
        <div class="col-lg-12">
            <div class="form-group">
                <textarea name="instruction" id="instruction" class="form-control"  rows="5" placeholder="If you have special requests for your order/shipments, please list here. This many including asking for Original Bill of Lading and Certificate of Origin documents, or shipping instructions" onkeyup="checkobxtick(this);">{{member.special_request}}</textarea>
            </div>
        </div>
        </div>
        <hr />
    <div class="form-group">
        <input type="hidden" value="update" name="action" />
        <input type="submit" value="Save" class="btn btn-lg btn-primary" />
    </div>
    </form>
    </div>
    <script type="text/javascript">
        function checkobxtick(element) {
          var textarea2 = document.getElementById("instruction"),
            event = new Event('change');
          var value = element.value;
          if(value!=''){
            $('#special_freight')[0].checked = true;
          }
        };
    </script>
{% endblock %}
