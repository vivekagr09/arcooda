{% set layout   = inputs.layout|default('sidebar') %}
{% set classes  = inputs.classes|default('') %}
{% set productcarousel     = inputs.productcarousel     %}
{% set carouseldata     = inputs.productcarouseldata     %}
<link rel="stylesheet" href="/css/global.css" />
<div id="CrauselDiv"></div>
<div id="carouselData" style="display: none;">
	<div data-cat="Thumbs video category">
		{% for carousel in productcarousel %}
		 <ul>
				        {% if carouseldata.type=='image'%}
						<li data-rl-src="/brochureimage/{{carousel.name}}" data-rl-target="_blank"></li>
						<li data-thumb-src="/brochureimage/{{carousel.name}}"></li>
						{% else %}
						{% if carousel.video_image %}
						<li data-thumb-src="/brochureimage/{{carousel.video_image}}" data-thumb-video-src="{{carousel.name}}"></li>
						{% else %}
						<li data-thumb-src="https://img.youtube.com/vi/{{getvideoid(carousel.name)}}/0.jpg" data-thumb-video-src="{{carousel.name}}"></li>
						{% endif %}
						{% endif %}			

			<li data-thumb-caption="" data-thumb-caption-offset="70">
							<h2 class="fwdrl-title" style="margin-top: 10px;margin-bottom:10px;font-size: 18px;padding-bottom: 0px; border-bottom:0px!important;">{{carousel.title}}</h2>
							<p class="fwdrl-desc" style="margin-bottom: 20px!important;color:#6c757d;font-size: 13px;"><i>{{carousel.caption}}</i></p>
							{% if carouseldata.button_active=='y' %}
							<a href="{{carousel.link}}" target="_blank" style="color:white;padding:5px;background-color:{{carouseldata.button_color}};font-size:15px;font-weight: 700;text-align: center;border-radius: 20px; text-decoration: none;"><span>{{carouseldata.button_text}}</span></a>
							{% endif %}
						</li>
			</ul>
		{% endfor %}
		
		
	</div>
</div>
<script src="/js/crausal.js"></script>
<script type="text/javascript">
