{#
// inputs:
// - product: object - product data object
// - layout:  string - one of [grid, list, table]
// - exclude: array  - indicates which content should be excluded from the template (default: [])
#}

{% set product = inputs.product %}
{% set layout  = inputs.layout %}
{% set exclude = inputs.exclude|default([]) %}

{% set root_classes = classnames('product-card') %}

{% if layout %}
    {% set root_classes = classnames(root_classes, 'product-card--layout--'~layout) %}
{% endif %}

<div class="{{ root_classes }}">
    {#<div class="product-card__actions-list">
        <button class="product-card__action product-card__action--quickview" type="button" aria-label="Quick view">
            {{ svg('quickview-16.svg') }}
        </button>
        {% if not ('actions' in exclude) %}
            <button class="product-card__action product-card__action--wishlist" type="button" aria-label="Add to wish list">
                {{ svg('wishlist-16.svg') }}
            </button>
            <button class="product-card__action product-card__action--compare" type="button" aria-label="Add to compare">
                {{ svg('compare-16.svg') }}
            </button>
        {% endif %}
    </div>#}

    <div class="product-card__image" style="text-align: center;">
        <a href="{{ product.url|e }}">
            <img src="{{ image(product.imagescategory[0], {size: 245}) }}" alt="{{ product.imagescategory[0].alt|e }}" title="{{ product.name|e }}" />
        </a>
        {#
        {% if not ('status-badge' in exclude) %}
            {% include '/components/status-badge.twig' with {inputs: {
                classes: 'product-card__fit',
                style: 'success',
                text: 'Part Fit for 2011 Ford Focus S',
                tooltip: 'Part Fit for 2011 Ford Focus S',
                icon: 'success',
            }} %}
        {% endif %}
        #}
    </div>

    <div class="product-card__info">
        {% if not ('meta' in exclude) %}
            <div class="product-card__meta"><span class="product-card__meta-title">SKU:</span> {{ product.sku }}</div>
        {% endif %}

        <div class="product-card__name">
            <div>
                {% if product.badges %}
                    <div class="product-card__badges">
                        {% for badge in product.badges %}
                             <div class="{{ classnames('tag-badge', 'tag-badge--'~badge|replace({' ': ''})) }}">{{ badge }}</div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if product.factory_second == 'yes' %} <div class="badge badge-danger">Seconds</div> {% endif %}<a href="{{ product.url|e }}">{{ product.name|e }}</a>
            </div>
        </div>

        {% if product.totalRatings > 0 %}

            <div class="product-card__rating">

                {% include '/components/rating.twig' with {inputs: {

                    classes: 'product-card__rating-stars',

                    rating: product.rating

                }} %}

                <div class="product-card__rating-label">({{ product.totalRatings }})</div>

            </div>

         {% endif %}

        {% if not ('features' in exclude) %}
            <div class="product-card__features">
                {{ markdown(product.excerpt) }}
                {{ markdown(product.product_details) }}
            </div>
        {% endif %}
    </div>

    <div class="product-card__footer">
        <div class="product-card__prices">
        {%if product.isProductAvailableByRule %}

        {% if product.discontinued=='n' %}
            {% if product.compareAtPrice %}
                <div class="product-card__price product-card__price--old" style="margin-right:6px;">{{ product.compareAtPrice }}</div>
                <div class="product-card__price product-card__price--new">{{ product.price|currency }}</div>
            {% else %}
                <div class="product-card__price product-card__price--current">{{ product.price|currency }}</div>
            {% endif %}
        
        {% endif %}
        {% else %}
            <div class="dd product-card__price product-card__price--new">Restricted</div>
        {% endif %}

        </div>
        {% if product.color|length > 0 %}
            {% if product.availabilityColorForAnyStock %}
                <span class="badge badge-success">Stock</span>
            {% else %}
                <span class="badge badge-please-ask">Please Ask</span>
            {% endif %} 
        {% else %}
            {% if product.discontinued == 'y' %}
                <!-- <span class="badge badge-danger">Sold Out</span> -->
            {% elseif product.availability in ['In Stock', 'Stock'] %}
                <span class="badge badge-success">{{ product.availability|e }}</span>
            {% elseif product.availability in ['Pleae Ask','Please Ask'] %}
                <span class="badge badge-please-ask">Please Ask</span>
             {% elseif product.availability in ['Sold Out'] %}
                <span class="badge badge-danger">{{product.availability}}</span>      
            {% else %}
                {% if product.availability in ['Pre Order'] %}
                    <span class="badge badge-warning">{{ product.availability|e }}</span>
                {% else %}
                    <span class="badge badge-weeks">{{ product.availability|e }}</span>
                {% endif %}
            {% endif %}
        {% endif %}    
        {% if not ('buttons' in exclude) %}

            {% if product.discontinued=='n' %}

            {%if product.isProductAvailableByRule %}
            <button class="product-card__addtocart-icon product-card__action--quickview {{(product.orderRule == 'inquiry_for_everyone')?'product-card__addtocart-icon-inquiry':''}}" type="button" aria-label="Add to cart" value="{{ product.url|e }}?source=quickview&amp;format=ajax">
                {{ svg_inline('cart-20.svg') }} 
            </button>
              {% endif %}
            {% endif %}
            {% if not ('list-buttons' in exclude) %}
                {% if product.discontinued=='n' %}
                <button class="product-card__addtocart-full product-card__action--quickview" type="button" value="{{ product.url|e }}?source=quickview&amp;format=ajax">
                    Add to cart
                </button>
                {% else %}
                     <button class="product-card__addtocart-full" type="button" onclick="window.open('{{ product.url|e('js') }}', '_self')">
                        View
                    </button>
                 {% endif %}
                {#
                <button class="product-card__wishlist" type="button">
                    {{ svg('wishlist-16.svg') }}
                    <span>Add to wishlist</span>
                </button>
                <button class="product-card__compare" type="button">
                    {{ svg('compare-16.svg') }}
                    <span>Add to compare</span>
                </button>
                #}
            {% endif %}
        {% endif %}
    </div>
</div>
