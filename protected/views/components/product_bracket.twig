<style type="text/css">
	.add-on-bracket{
        width: 100%; padding: 5px; border: 3px solid #73d98d; background-color: #ececf4;
    }

</style>
{% set bracketProducts  = inputs.bracketProducts  %}
{% if bracketProducts|length > 0 %}
<div class="product__info-card" style="margin-bottom: 20px;">
	<div class="widget__header">
        <h4 style="padding-right: 7px;">Mounting Bracket</h4> <i><small>(this will be added with your order)</small></i>
    </div>
    <div class="widget-products__list">
        {% for bracketProduct in bracketProducts %}
            <div class="widget-products__item {{bracketProduct.main == 'y' ? 'add-on-bracket': ''}}" >
            	<div style="padding: 5px">
            		<input type="radio" name="bracketoption" value="{{bracketProduct.id}}" class="with-option checkout-option" {{bracketProduct.main == 'y' ? 'checked': ''}} style="accent-color: #73d98d;">
            	</div>
                <div class="widget-products__image">
                    <a href="{{ bracketProduct.product.url|e }}">
                        <img src="{{ image(bracketProduct.product.images[0], {size: 64}) }}" alt="" />
                    </a>
                </div>
                <div class="widget-products__info">
                    <div class="widget-products__name" style="display: flex;">
                    		<div style="width:80%">
                        	<a href="{{ bracketProduct.product.url|e }}">{{ bracketProduct.product.name|e }}</a>
                        	</div>
                        	{% if bracketProduct.addontext %}
                        	<div style="width:20%">
                        		<i class="far fa-question-circle" data-toggle="tooltip" data-placement="top" title="{{bracketProduct.addontext}}"></i>
                        	</div>
                        	{% endif %}
                    </div>

                    <div class="widget-products__prices">
                    	{% if bracketProduct.is_free == 'y' %}
                    		<div class="widget-products__price widget-products__price--old">
	                            {{ bracketProduct.product.price.format('[symbol][price_inc_gst]')|currency|e }}
	                        </div>
	                        <div class="widget-products__price widget-products__price--new" style="color:red">
	                        	FREE
	                        </div>
                    	{% else %}
	                        {% if bracketProduct.product.compareAtPrice %}
	                            <div class="widget-products__price widget-products__price--new">{{ bracketProduct.product.price.format('[symbol][price_inc_gst]')|currency|e }}</div>
	                            <div class="widget-products__price widget-products__price--old">{{ bracketProduct.product.compareAtPrice.format('[symbol][price_inc_gst]')|currency|e }}
	                            </div>
	                        {% else %}
	                            <div class="widget-products__price widget-products__price--current">
		                            {{ bracketProduct.product.price.format('[symbol][price_inc_gst]')|currency|e }}
		                        </div>
	                        {% endif %}
	                    {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
        {% if product.getbracketdiscount.backet_discunt_active == 'y' and  product.getbracketdiscount.backet_discunt_enable == 'y' %}
            <div class="widget-products__item {{product.getbracketdiscount.bracket_discount_main == 'y' ? 'add-on-bracket': ''}}" >
            	<div style="padding: 5px">
            		<input type="radio" name="bracketoption" value="discount" class="with-option checkout-option" {{product.getbracketdiscount.bracket_discount_main == 'y' ? 'checked': ''}} style="accent-color: #73d98d;">
            	</div>
                <div class="widget-products__image">
                     <img src="/images/nobracket.jpeg" alt="" width="64" height="64" />
                </div>
                <div class="widget-products__info">
                    <div class="widget-products__name" style="display: flex;">
                    		<div style="width:80%">
                        	No Monitor Brackets Included
                        	</div>
                        	<!-- {% if bracketProduct.addontext %}
                        	<div style="width:20%">
                        		<i class="far fa-question-circle" data-toggle="tooltip" data-placement="top" title="{{bracketProduct.addontext}}"></i>
                        	</div>
                        	{% endif %} -->
                    </div>

                    <div class="widget-products__prices">
                    	<div class="widget-products__price">
	                            Discount ${{product.getbracketdiscount.backet_discunt_value}}
	                        </div>
                    </div>
                </div>
            </div>
         {% endif %}
    </div>
</div>
{% endif %}
<script type="text/javascript">
	document.addEventListener("DOMContentLoaded", function () {
		 const value = $('input[name="bracketoption"]:checked').val();
		  $('#bracketoption_id').val(value);
	});
	$(document).on('change', 'input[name="bracketoption"]', function () {
    // Remove class from all items
	    $('.widget-products__item').removeClass('add-on-bracket');
	    // Add class to the selected item's container
	    $(this).closest('.widget-products__item').addClass('add-on-bracket');
	     $('#bracketoption_id').val($(this).val());
	});
</script>