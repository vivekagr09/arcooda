{% set prefix = 'review-add' %}
{% set reviews_list = {
    "5": "5 Stars Rating",
    "4": "4 Stars Rating",
    "3": "3 Stars Rating",
    "2": "2 Stars Rating",
    "1": "1 Stars Rating",
} %}   
    <div class="modal fade" id="{{ prefix }}-modal" tabindex="-1" role="dialog"><div class="modal-dialog modal-lg" role="document"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" style="width: 100%;">
                <table>
                    <tr>
                        <td width="23%">
                            Add Review for - 
                        </td>
                        <td>
                            <span style="background-color: yellow;">{{ product.name|e }}</span>
                        </td>
                    </tr>
                </table>

            </h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body">
            <form action="/review" method="post" name="reviewform" id="reviewform" id="dashboardReview">
                <div class="row">
                        <div class="col-md-12">
                            <input type="hidden" name="product_id" value="{{ product.id }}" />
                            <input type="hidden" name="user_id" value="{{ user.id }}" />
                            <input type="hidden" name="user_name" value="{{ user.initials }}" />
                            <input type="hidden" name="user_country" value="{{ user.country }}" />
                            <div class="form-group">
                                <label for="reviews"><b>Review Stars</b></label></br>
                                <select class="form-control form-control-lg" id="reviews" name="reviews" style="max-width:50%;" required>
                                    {# <option value="" disabled selected>Select your rating</option> #}
                                    {% for key, value in reviews_list %}
                                        <option value="{{ key }}">{{ value }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="comment" class="col-form-label"><b>Your Review</b> <span style="font-size:14px;font-style:italic;">(for online display)</span></label></br>
                                <textarea class="form-control" id="comment" name="comment" rows="3" placeholder="Please leave your comments." required></textarea>
                            </div>

                            <div class="form-group">
                                <label for="feedback" class="col-form-label"><b>Private Feedback</b> <span style="font-size:14px;font-style:italic;">(Confidential, for Office Use Only)</span></label></br>
                                <textarea class="form-control" id="feedback" name="feedback" rows="3" placeholder="Please leave your feedback."></textarea>
                            </div>
                            <div class="form-group">
                                <label for="feedback" class="col-form-label"><b>Attachments</b></label></br>
                                <div id="dropzone-container">
                                    <label for="image-upload">Upload Images:</label>
                                    <div class="dropzone" id="my-dropzone"></div>
                                </div>
                            </div>
                            <div id="attached-file"></div>
                        </div>
                </div>
                <hr />
                <div class="form-group">
                    <input type="hidden" value="add" name="action" />
                    <input type="submit" value="Post Your review" class="btn btn-lg- btn-primary" id="submitReview"/>
                </div>
            </form>
        </div>
    </div></div></div>
    <script type="text/javascript">
            $(document).ready(function() {
                var myDropzone;
                var productNumber = $('input[name="product_id"]').val();
                const totalReviewPages = parseInt($('input[name="totalReviewPages"]').val());
                let currentPage = 1; // Initialize the current page variable
                const product_id = productNumber; // Replace with your actual product
                var elementId = document.getElementById('my-dropzone');

                if (elementId && elementId.dropzone) {
                    elementId.dropzone.destroy();
                }

                myDropzone = new Dropzone("#my-dropzone", {
                    url: '/contact/review_attachment.php?id=' + product_id,
                    maxFilesize: 2, // Maximum file size in MB
                    acceptedFiles: 'image/*', // Accept only images
                    addRemoveLinks: true, // Allow file removal
                    dictRemoveFile: "Remove", // Customize the remove link text
                    autoProcessQueue: false, // Disable automatic upload on file selection
                    parallelUploads: 5, // Allow multiple files to be uploaded at once
                    uploadMultiple: true, // Enable multiple file uploads
                    init: function() {
                        var dropzoneInstance = this;
                        
                        // Clear any existing listeners to prevent duplicates
                        this.off("success");
                        
                        this.on("success", function(file, responseArray) {
                            JSON.parse(responseArray).forEach(function(response) {
                                $('#attached-file').append('<input type="hidden" name="attachments[]" value="' + response + '">');
                            });
                        });

                        this.on('queuecomplete', function() {
                            // Submit the form after all files are uploaded
                            $("form[name='reviewform']").submit();
                        });
                        
                    }
                });

                $("form[name='reviewform']").validate({
                    rules: {
                        reviews: {
                            required: true,
                        },
                        comment: {
                            required: true,
                        },
                    },
                    messages: {
                        reviews: {
                            required: "Please select a rating"
                        },
                        comment: {
                            required: "Please provide a review",
                        },
                    },
                    submitHandler: function(form) {
                        if (myDropzone.getQueuedFiles().length > 0) {
                            myDropzone.processQueue();
                        } else {
                            // No files to upload, submit the form immediately
                            $.ajax({
                                url: $(form).attr('action'), // Get form action URL
                                type: 'POST', // Form method
                                data: $(form).serialize(), // Serialize form data
                                success: function(response) {
                                    var response = JSON.parse(response);
                                    if (response.success) {
                                        $('#display-review-data').html(response.html);
                                        $('.posts-view__pagination').html(response.paginationHtml);
                                        $('#review-add-modal').modal('hide');
                                        $('#reviewform')[0].reset();
                                        $('#post-review-div').hide();
                                        $('#total_review_count').html(parseInt($('#total_review_count').html()+1));
                                    } else {
                                        alert('Error: ' + response.issues);
                                    }
                                },
                                error: function(xhr) {
                                    alert('Error: ' + xhr.responseText);
                                }
                            });
                        }
                    }
                });
            });

            $(document).ready(function() {
                $(document).on('click', '.page-link', function(event) {
                    event.preventDefault();  // Prevent page reload

                    $.ajax({
                        url: $(this).attr('href'), 
                        type: 'GET',              
                        success: function(response) {
                             var response = JSON.parse(response);
                               if(response.success){
                                    $('#display-review-data').html(response.html);
                                    $('.posts-view__pagination').html(response.paginationHtml);
                               }else{
                                    alert('there is some issue please try again later');
                               }
                        },
                        error: function(xhr, status, error) {
                            // Handle errors here
                            console.error(xhr.responseText);
                        }
                    });
                });
            });

    </script>