<style type="text/css">
	.add-on-ckeck{
        width: 100%; padding: 5px; border: 3px solid #3d89f3; background-color: #ececf4;
    }
</style>
{% set addOnProducts  = inputs.addOnProducts  %}
{% if addOnProducts|length > 0 %}
<div class="product__info-card" style="margin-bottom: 20px;">
	<div class="widget__header" style="display:flex;">
        <h4 style="padding-right: 7px;">Options</h4> <i><small>(will be added to your cart)</small></i>
    </div>
    <div class="widget-products__list">
    	<div class="widget-products__item add-on-ckeck">
    		<div >
        		<input type="checkbox" name="options[]" value="0" class="without-option checkout-option" checked>
        		No Add-on
        	</div>
    	</div>
        {% for addOnProduct in addOnProducts %}
            <div class="widget-products__item" >
            	<div style="padding: 5px">
            		<input type="checkbox" name="options[]" value="{{addOnProduct.product.id}}" class="with-option checkout-option {{addOnProduct.is_free == 'y' ? 'checkout-option-disable': ''}}" {{addOnProduct.is_free == 'y' ? 'checked': ''}}>
            	</div>
                <div class="widget-products__image">
                    <a href="{{ addOnProduct.product.url|e }}">
                        <img src="{{ image(addOnProduct.product.images[0], {size: 64}) }}" alt="" />
                    </a>
                </div>
                <div class="widget-products__info">
                    <div class="widget-products__name" style="display: flex;">
                    		<div style="width:80%">
                        	<a href="{{ addOnProduct.product.url|e }}">{{ addOnProduct.product.name|e }}</a>
                        	</div>
                        	{% if addOnProduct.addontext %}
                        	<div style="width:20%">
                        		<i class="far fa-question-circle" data-toggle="tooltip" data-placement="top" title="{{addOnProduct.addontext}}"></i>
                        	</div>
                        	{% endif %}
                    </div>

                    <div class="widget-products__prices">
                    	{% if addOnProduct.is_free == 'y' %}
                    		<div class="widget-products__price widget-products__price--old">
	                            {{ addOnProduct.product.price.format('[symbol][price_inc_gst]')|currency|e }}
	                        </div>
	                        <div class="widget-products__price widget-products__price--new" style="color:red">
	                        	FREE
	                        </div>
                    	{% else %}
	                        {% if addOnProduct.product.compareAtPrice %}
	                            <div class="widget-products__price widget-products__price--new">{{ addOnProduct.product.price.format('[symbol][price_inc_gst]')|currency|e }}</div>
	                            <div class="widget-products__price widget-products__price--old">{{ addOnProduct.product.compareAtPrice.format('[symbol][price_inc_gst]')|currency|e }}
	                            </div>
	                        {% else %}
	                            <div class="widget-products__price widget-products__price--current">
		                            {{ addOnProduct.product.price.format('[symbol][price_inc_gst]')|currency|e }}
		                        </div>
	                        {% endif %}
	                    {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endif %}
<script type="text/javascript">
	document.addEventListener("DOMContentLoaded", function () {
	    const noAddOnCheckbox = document.querySelector("input[name='options[]'][value='0']");
	    const addOnCheckboxes = document.querySelectorAll("input[name='options[]']:not([value='0'])");
	    const quantityDiv = document.querySelector(".product__actions-item--quantity");
	    
	    const hiddenInput = document.createElement("input");
	    hiddenInput.type = "hidden";
	    hiddenInput.name = "options_ids";
	    
	    if (quantityDiv) {
	        quantityDiv.appendChild(hiddenInput);
	    }

	    function updateHiddenInput() {
	        const selectedValues = Array.from(addOnCheckboxes)
	            .filter(checkbox => checkbox.checked && !checkbox.classList.contains("checkout-option-disable"))
	            .map(checkbox => checkbox.value)
	            .join(",");
	        hiddenInput.value = selectedValues;
	    }

	    noAddOnCheckbox.addEventListener("change", function () {
		        if (this.checked) {
		        	this.parentNode.parentNode.classList.add("add-on-ckeck");
		            addOnCheckboxes.forEach(checkbox => {
		            	if (checkbox.classList.contains("checkout-option-disable")) {
			                return;
			            }
		            	checkbox.checked = false
		            	checkbox.parentNode.parentNode.classList.remove("add-on-ckeck");
		        });
	            hiddenInput.value = "";
	        }
	    });

	    addOnCheckboxes.forEach(checkbox => {
	        checkbox.addEventListener("change", function () {
	            if (this.checked) {
	            	this.parentNode.parentNode.classList.add("add-on-ckeck");
	            	noAddOnCheckbox.parentNode.parentNode.classList.remove("add-on-ckeck");
	                noAddOnCheckbox.checked = false;
	            }else{
	            	this.parentNode.parentNode.classList.remove("add-on-ckeck");
	            }
	            updateHiddenInput();
	        });
	    });
	});
	$(document).on('click', '.checkout-option-disable', function (e) {
	    e.preventDefault(); // 
	});
</script>