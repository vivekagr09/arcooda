{#
// inputs:
// - title:
// - description:
// - keywords:
// - alert:
// - issues:
// - result:
#}

{% set global_page_title           = inputs.title|default('Change Password')      %}
{% set global_page_description     = inputs.description|default('')               %}
{% set global_page_keywords        = input.keywords|default('')                   %}
{% set global_page_canonical       = '/account/password'                          %}
{% set global_page_breadcrumbs     = [
	{title : 'Home',            url : '/'                  },
    {title : 'My Account',      url : '/account/dashboard' },
	{title : global_page_title, url : global_page_canonical},
] %}
{% set global_current_account_page = global_page_canonical                        %}

{% set alert     = inputs.alert                                                   %}
{% set issues    = inputs.issues                                                  %}
{% set result    = inputs.result                                                  %}

{% extends '/layouts/account.twig' %}

{% block account_body %}
    <div class="card">
        {% if result %}<div class="alert alert-{{ result }}" role="alert">{{ alert|e }}</div>{% endif %}
        <div class="card-header"><h5>Change Password</h5></div>
        <div class="card-divider"></div>
        <div class="card-body card-body--padding--2"><div class="row no-gutters"><div class="col-12 col-lg-7 col-xl-6"><form action="" method="post">
            <div class="form-group">
                <div class="form-row">
                    <div class="col-4">
                <label for="account-password-new-password">New Password<span class="color-red">*</span></label>
            </div>
            <div class="col-8">
                <input autocomplete="new-password" class="form-control{{ (issues['new-password']) ? ' is-invalid' : '' }}" id="newPassword" minlength="8" name="new-password" placeholder="New Password" required="required" type="password" />
                {% if issues['new-password'] %}<span class="invalid-feedback"><strong>{{ issues['new-password'] }}</strong></span>{% endif %}
                <div id="password-strength-status"></div>
                
            </div>
            </div>
            </div>
            <div class="form-group">
                <div class="form-row">
                    <div class="col-4">
                    <label for="account-password-confirm-password">Confirm Password<span class="color-red">*</span></label>
                </div>
                <div class="col-8">
                <input autocomplete="new-password" class="form-control{{ (issues['confirm-password']) ? ' is-invalid' : '' }}" id="account-password-confirm-password" minlength="8" name="confirm-password" placeholder="Confirm Password" required="required" type="password" />
                <span class="invalid-feedback passnotmatch" style="display:none;">Password do not match</span>
                {% if issues['confirm-password'] %}<span class="invalid-feedback"><strong>{{ issues['confirm-password'] }}</strong></span>{% endif %}
            </div>
        </div>
            </div>
            <div class="form-group mb-0">
                <input type="hidden" name="action" value="update" />
                <button class="btn btn-primary mt-3">Change</button>
            </div>
        </form></div></div></div>
    </div>
{% endblock %}
