    <div class="dashboard">

        {% if currOrders %}<div class="dashboard__orders card">
            <div class="card-header"><h5>Current Orders & Inquiries</h5></div>
            <div class="card-divider"></div>
            <div class="card-table"><div class="table-responsive-sm">
                <table>
                <thead>
                    <tr>
                        <th width="10%">Order</th>
                        <th width="15%">Date</th>
                        <th width="15%">Total</th>
                        <th width="15%">Status</th>
                        <th width="15%">Tracking</th>
                        <th width="10%">Notes</th>
                        <th width="10%">Message</th>
                        <th width="10%">Reorder</th> 
                    </tr>
            </thead>
                <tbody>
                {% if currOrders|length > 0 %}
                {% for order in currOrders[:5] %}
                    {% set class = (currOrders|length > 1 and order.display_to_customer_all|length == 0) ? 'border-top-blue' : '' %}
                     <tr>
                        <td class="{{ class }}" style="text-align:center"><a href="/account/invoice?invoice_id={{order.id}}" target="_blank">{{ order.number }}</a>
                            {% if order.status == 'Awaiting Payment' or order.status == 'Open' %}
                                <button  type="button" class="btn btn-danger" style="border-color: #333; background: #333;    font-size: 12px; padding: 5px 16px;" onmouseout="this.style.background='#333'" onmouseover="this.style.background='#c82333'" onclick="openCancelModel('{{order.number}}','{{order.id}}')">Cancel</button> {% endif %}
                        </td>
                        <td class="{{ class }}">{{ order.date }}</td>
                        <td class="{{ class }}">{{ order.total|currency }}</td>
                        <td class="{{ class }}" style="text-align:center">
                            {{ order.status }}
                            {% if order.status == 'Awaiting Payment' %}
                            <button  type="button" class="btn btn-primary" style="border-color: #333; background: #333;    font-size: 12px; padding: 5px 16px;" onmouseout="this.style.background='#333'" onmouseover="this.style.background='#0069d9'" onclick='window.location.href="/payment/payment-checkout?id={{order.id}}&crc={{order.rand_num}}"'>Pay</button>
                            {% endif %}
                        </td>
                        <td class="{{ class }}">
                            {% if order.tracking_number %}
                                {% if order.frieght_traking_url %}
                                    <a href="{{order.frieght_traking_url}}" target="_blank" data-toggle="tooltip" data-placement="top" title="" data-original-title="{{order.fright_tracking_service}}">
                                    {{order.tracking_number}}</a>
                                {% else %}
                                    <span target="_blank" data-toggle="tooltip" data-placement="top" title="" data-original-title="{{order.fright_tracking_service}}"> {{order.tracking_number}} </span>
                                {% endif %}
                            {% else %}
                                N/A
                            {% endif %}
                        </td>
                        <td class="text-align-center {{ class }}">
                           {% if order.display_to_customer_all|length > 0 %}
                                <div class="tooltip-container" style="display:inline-block;">
                                    <img src="/img/favicon.ico" width="30" class="tooltip-trigger">
                                    <div class="custom-tooltip" style="display:none;">
                                        {% for note in order.display_to_customer_all %}
                                            <div class="tooltip-item">
                                                <span class="tooltip-date">{{ note.date|date('d/m/Y') }}</span>
                                                <span class="tooltip-message">{{ note.message }}</span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}

                        </td>
                        <td class="{{ class }}"><i class="fas fa-comments" onclick="openMsgModel('{{order.number}}','{{order.id}}')" style="font-size: 30px;cursor:pointer;"></i></td>
                        <td class="{{ class }}"><i class="fas fa-shopping-cart"  data-toggle="modal" data-target="#account-reorder{{ order.id }}-modal" style="font-size: 30px;cursor:pointer;"></i>
                        </td>
                    
                    </tr>
                    {% if order.display_to_customer_all|length > 0 %}
                    <tr>
                        <td colspan="8" class="border-top-blue" style="border-top:none;">
                            <div class="container">
                                <div class="row" style="padding:14px;border: 1px solid #b5e61d">
                                    <div class="col-md-2" style="background:#b5e61d"><b>Arcooda Updates</b></div>
                                    <div class="col-md-10" style="color:red">{{ order.display_to_customer_all[0].message }} on {{ order.display_to_customer_all[0].date|date("d/m/Y") }}
                                    </div>
                                </div>                        
                            </div>
                        </td>
                    </tr>
                    {% endif %}

                {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="8" style="font-style:italic;">No Orders or Inquiries</td>
                    </tr>
                {% endif %}
            </tbody>
            </table></div></div>
        </div>{% endif %}
