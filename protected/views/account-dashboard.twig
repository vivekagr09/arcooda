                        </td>
                    
                    </tr>
                {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="8" style="font-style:italic;">No Orders or Inquiries</td>
                    </tr>
                {% endif %}
                </tbody>
            </table></div></div>
        </div>{% endif %}
    </div>
    {% set prefix = 'account-contact' %}
    <div class="modal fade" id="{{ prefix }}-modal" tabindex="-1" role="dialog"><div class="modal-dialog modal-lg" role="document"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Send Message to our team</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body"><form action="/account/orders" method="post">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">

                        <div class="row">
                        <div class="col-md-4">
                            <label for="{{ prefix }}-company_name">Our Reference <span class="color-red">*</span></label>
                            <input type="text" name="order_id" class="form-control" id="order_id" readonly="true" required/>
                            <input type="hidden" name="id" class="form-control" id="invoice_id"/>
                        </div>
                        <div class="col-md-8">
                            <label for="{{ prefix }}-company_name">Subject/Title <span class="color-red">*</span></label>
                            <input type="text" name="subject" class="form-control" id="{{ prefix }}-company_name" required/>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label for="{{ prefix }}-company_name">Message<span class="color-red">*</span></label>
                            <textarea name="message" class="form-control" id="{{ prefix }}-company_name" rows="5" required></textarea>
                    </div>
                </div>
            </div>
            <hr />
            <div class="form-group center-align">
                <input type="hidden" value="contact" name="action" />
                <input type="submit" value="Send Message" class="btn btn-lg- btn-primary" />
            </div>
        </form></div>
    </div></div></div>
    {% set prefix = 'account-cancel' %}
    <div class="modal fade" id="{{ prefix }}-modal" tabindex="-1" role="dialog"><div class="modal-dialog modal-lg" role="document"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Do you want to cancel this order?</h5>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
        </div>
        <div class="modal-body"><form action="" method="post">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">

                        <div class="row">
                        <div class="col-md-4">
                            <label for="{{ prefix }}-company_name">Our Reference<span class="color-red">*</span></label>
                            <input type="text" name="cancel_order_id" class="form-control" id="cancel_order_id" readonly="true" required/>
                            <input type="hidden" name="id" class="form-control" id="cancel_invoice_id"/>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label for="{{ prefix }}-company_name">Reason of cancellation<span class="color-red">*</span></label>
                            <textarea name="message" class="form-control" id="{{ prefix }}-company_name" rows="5" required></textarea>
                    </div>
                </div>
            </div>
            <hr />
            <div class="form-group center-align">
                <input type="hidden" value="cancelorder" name="action" />
                <input type="submit" value="Send Message" class="btn btn-lg- btn-primary" />
            </div>
        </form></div>
    </div></div></div>
