{#
// inputs:
// - title:
// - description:
// - keywords:
// - alert:
// - issues:
// - result:
#}

{% set global_page_title           = inputs.title|default('Forgotten Password')   %}
{% set global_page_description     = inputs.description|default('')               %}
{% set global_page_keywords        = input.keywords|default('')                   %}
{% set global_page_canonical       = '/account/passwordFind'                      %}
{% set global_page_breadcrumbs     = [
	{title : 'Home',            url : '/'},
	{title : global_page_title, url : global_page_canonical},
] %}
{% set global_current_account_page = global_page_canonical                        %}

{% set alert     = inputs.alert                                                   %}
{% set issues    = inputs.issues                                                  %}
{% set result    = inputs.result                                                  %}

{% extends '/layouts/default.twig' %}

{% block site_body %}
    {% include '/blocks/block-header.twig' with {inputs: {
        title: 'Forgotten Password',
        breadcrumb: global_page_breadcrumbs,
    }} %}
    <div class="block"><div class="container"><div class="row justify-content-center"><div class="col-sm-10 col-md-8 col-lg-6 bg-white border p-sm-5"><form action="" method="post" id="passwordFind">
        {% if result %}<div class="alert alert-{{ result }}" role="alert">{{ alert|e }}</div>{% endif %}
		<div class="form-group">
			<div class="form-row">
				<div class="col-4">
					<label for="account-passwordFind-username">Email Address*</label>
				</div>
				<div class="col-8">
					<input autocomplete="username" class="form-control{{ (issues.username) ? ' is-invalid' : '' }}" id="account-passwordFind-username" name="username" placeholder="name@mail.com" required="required" type="email" />
					{% if issues.username %}<span class="invalid-feedback"><strong>{{ issues.username }}</strong></span>{% endif %}
				</div>
			</div>
		</div>
		<div class="form-group">
			<div class="form-row">
				<div class="col-4">
					
				</div>
				<div class="col-8 text-center">
					<input type="hidden" name="action" value="recover" />
					<input type="submit" value="Recover Password" class="btn btn-primary" />
				</div>
			</div>
		</div>
	</form></div></div></div></div>
    {% include '/blocks/block-space.twig' with {inputs: {
		layout: 'before-footer',
	}} %}
{% endblock %}
