{#
// inputs:
// - title:
// - description:
// - keywords:
#}

{% set global_page_title           = inputs.title|default('Credit Card Payment')  %}
{% set global_page_description     = inputs.description|default('')               %}
{% set global_page_keywords        = input.keywords|default('')                   %}
{% set global_page_canonical       = '/cart/creditcard'                           %}
{% set global_page_breadcrumbs     = [
    {title : 'Home', url : '/'},
    {title : global_page_title, url : global_page_canonical},
] %}
{% set global_current_cart_page    = global_page_canonical                        %}

{% from '/macros/controls.twig' import input_check, input_radio %}

{% extends '/layouts/default.twig' %}

{% block site_body %}
    {% include '/blocks/block-header.twig' with {inputs: {
        title: 'Credit Card Payment',
        breadcrumb: global_page_breadcrumbs,
    }} %}
    <div class="checkout block"><div class="container container-xl"><div class="row justify-content-center"><div class="col-12 col-lg-6 col-xl-7"><div class="card mb-lg-0"><div class="card-body card-body--padding--2">
        <h3 class="card-title">Credit Card Payment</h3>
        <div class="form-group">
            <label for="company-name">Company Name</label>
            <input type="text" class="form-control" name="company_name" id="company-name">
        </div>
        <div class="form-group">
            <label for="reference">Reference</label>
            <input type="text" class="form-control" nmae="reference" id="reference">
        </div>
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" name="email" class="form-control" id="email">
        </div>
        <div class="form-group">
            <label for="payment-amount">Payment amount</label>
            <input type="number" name="payment_amount" class="form-control" id="payment-amount" min="0" step="0.01">
        </div>
        <div class="form-group">
            <label for="cardholder-name">Carholder Name</label>
            <input type="text" class="form-control" name="cardholder_name" id="cardholder-name">
        </div>
        <div class="form-group"><div id="card-element"></div></div>
        <div class="form-group">
            <label for="notes-comments">Notes/Comments</label>
            <textarea id="notes-comments" class="form-control" rows="4" name="notes_comments"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-xl btn-block" id="place-order-btn">Submit Payment</button>
    </div></div></div></div></div></div>
    {% include '/blocks/block-space.twig' with {inputs: {
        layout: 'before-footer',
    }} %}
{% endblock %}
