{#
// inputs:
// - megamenu: object - megamenu data
// - classes:  string - list of CSS classes
#}

{% set megamenu = inputs.megamenu %}
{% set classes = inputs.classes %}

{% set root_classes = classnames('megamenu', classes) %}

<div class="{{ root_classes }}">
    {% if megamenu.image %}
        <div class="megamenu__image">
            <img src="{{ megamenu.image|e }}" alt="{{ megamenu.image.alt|e }}" />
        </div>
    {% endif %}
    <div class="row">
        {% for column in megamenu.columns %}
            <div class="{{ 'col-'~column.size }}">
                {% for item in column.items %}
                    {% if item.type == 'links' %}
                        <ul class="megamenu__links megamenu-links megamenu-links--root">
                            {% for link in item.links %}
                                <li class="{{ classnames('megamenu-links__item', {'megamenu-links__item--has-submenu': link.links}) }}">
                                    <a class="megamenu-links__item-link" href="{{ link.url|e }}">{{ link.title|e }}</a>
                                    {% if link.links %}
                                        <ul class="megamenu-links">
                                            {% for sublink in link.links %}
                                                <li class="megamenu-links__item"><a class="megamenu-links__item-link" href="{{ sublink.url|e }}">{{ sublink.title|e }}</a></li>
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</div>
