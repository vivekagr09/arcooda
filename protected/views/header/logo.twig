{% set season_graphics    = inputs.season_graphic %}
<a href="/" class="logo">
    <div class="logo__slogan">
        Coin Operated / Amusement / Arcade / Gaming / Video Game / and Merchandise products at the lowest possible prices.
    </div>
    <div class="logo__image">
        <!-- logo -->
		<!--img class="w-100" src="data:image/png;base64," /-->
		{% if season_graphics.header_graphic %}
		<img class="w-100" src="/graphicsimage/{{season_graphics.header_graphic}}" alt="logo"/>
		{% else %}
		<img class="w-100" src="/brand.png" alt="logo" />
		{% endif %}
        <!-- logo / end -->
    </div>
</a>
