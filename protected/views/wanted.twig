{#
// inputs:
// - page_title:
// - page_description:
// - page_keywords:
// - page_canonical:
// - page_breadcrumbs:
// - error:
// - success:
// - tab:
// - updated:
#}
{% set global_page_title       = inputs.page_title %}
{% set global_page_description = inputs.page_description %}
{% set global_page_keywords    = inputs.page_keywords %}
{% set global_page_canonical   = inputs.page_canonical %}
{% set global_page_breadcrumbs = inputs.page_breadcrumbs %}
{% set total           = inputs.total %}
{% set products   = inputs.products   %}
{% set page            = inputs.page %}
{% set page_url        = inputs.page_url %}
{% set pages           = inputs.pages %}
{% set filters         = inputs.filters %}
{% set show            = inputs.show %}
{% set sort            = inputs.sort %}
{% set offcanvas = grid in ['grid-4-full', 'grid-5-full', 'grid-6-full'] ? 'always' : 'mobile' %}
{% extends '/layouts/default.twig' %}

{% block site_body %}
   {% include '/blocks/block-header.twig' with {inputs: {
        breadcrumb: global_page_breadcrumbs,
        cart_items: [],
        title: global_page_title
    }} %}
    <style>
  .product-card .product-card__addtocart-full {background: #e885a7;}
</style>
    <div class="block-split block-split--has-sidebar">
   
      <div class="container">
        <div class="block-split__row row no-gutters">
          <div class="block-split__item block-split__item-sidebar col-auto">
          {% include '/components/shop-sidebar.twig' with {inputs: {
                offcanvas: offcanvas,
                filters: filters,
                latest_products: [],
            }} %}
          </div>
            <div class="block-split__item block-split__item-content col-auto">
                <div class="block">
                <div class="products-view">
                  <div class="{{ classnames('products-view__options view-options', 'view-options--offcanvas--'~offcanvas) }}">
                    <div>
                      <div style="width:70%;"></div>
                       <button class="btn btn-warning btn-lg btn-block" onclick="window.open('/contact/manual_wanted.php', 'quoteWin', 'width=576,height=600,resizable,scrollbars');" style="width: 25%;float: right;margin-top: -77px;"> &nbsp; &nbsp; &nbsp; &nbsp; Add to Wanted &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; </button>
                    </div>
                    <div class="view-options__body">
                      <div><i>Please find below products we are currently looking to buy. If you have these items and would like to sell to us. Please click the sell to us next to the item.</i></div>
                    </div>
                  </div>
            <div class="products-view__options view-options view-options--offcanvas--mobile">
                          <div class="view-options__body">

                              <div class="view-options__legend">Showing {{ products|length }} of {{ total }} products</div>
                              <div class="view-options__spring"></div>
                              <div class="view-options__select">
                                  <label for="view-option-sort">Sort:</label>
                                  <select id="view-option-sort" class="form-control form-control-sm" name="sort" onchange="window.location.href='?show={{ show }}&sort='+ this.value;">
                                      <option value="Product Name" {{ sort == 'Product Name' ? 'selected' : '' }}>Product Name</option>
                                      <option value="Latest Items" {{ sort == 'Latest Items' ? 'selected' : '' }}>Latest Items</option>
                                  </select>
                              </div>

                              <div class="view-options__select">
                                  <label for="view-option-limit">Show:</label>
                                  <select id="view-option-limit" class="form-control form-control-sm" name="show" onchange="window.location.href='?show=' + this.value;">
                                      <option value="16" {{ show == 16 ? 'selected' : '' }}>16</option>
                                      <option value="32" {{ show == 32 ? 'selected' : '' }}>32</option>
                                      <option value="48" {{ show == 48 ? 'selected' : '' }}>48</option>
                                      <option value="64" {{ show == 64 ? 'selected' : '' }}>64</option>
                                      <option value="80" {{ show == 80 ? 'selected' : '' }}>80</option>
                                      <option value="96" {{ show == 96 ? 'selected' : '' }}>96</option>
                                      <option value="112" {{ show == 112 ? 'selected' : '' }}>112</option>
                                  </select>
                              </div>
                          </div>
                          {#<div class="view-options__body view-options__body--filters">
                              <div class="view-options__label">Active Filters</div>
                              <div class="applied-filters"><ul class="applied-filters__list">
                                  <li class="applied-filters__item"><a href="" class="applied-filters__button applied-filters__button--filter">Sales: Top Sellers {{ svg_inline('cross-9-light.svg') }}</a></li>
                                  <li class="applied-filters__item"><a href="" class="applied-filters__button applied-filters__button--filter">Color: True Red {{ svg_inline('cross-9-light.svg') }}</a></li>
                                  <li class="applied-filters__item"><button type="button" class="applied-filters__button applied-filters__button--clear">Clear All</button></li>
                              </ul></div>
                          </div>#}
            </div>
             <div class="products-view__list products-list products-list--grid--4" data-layout="list" data-with-features="false">
               <div class="products-list__head">
                  <div class="products-list__column products-list__column--image">Image</div>
                  <div class="products-list__column products-list__column--product">Product</div>
                  <div class="products-list__column products-list__column--price">Price</div>
               </div>
               <div class="products-list__content">
                {% if products | length > 0 %}
                  {% for product in products %}
                  <div class="products-list__item">
                     <div class="product-card">
                        <div class="product-card__image">
                        
                           <img src="{{ image(product.images[0], {size: 250}) }}"  style="min-width: 250px;min-height: 250px;">
                           
                        </div>
                        <div class="product-card__info" style="margin-left: 31px;">
                           <div class="product-card__name">
                              <div>
                                 {{ product.item|e }}
                              </div>
                           </div>
                           <div class="product-card__features" style="    padding-bottom: 29px;">
                              {{ product.description|e }}
                           </div>
                           <table>
                             {% if product.categorytype %} 
                              <tr class="product-card__features" style="font-size: 12px;">
                                <td style="text-align: right;"><b>Category : </b></td><td> {{ product.categorytype|e }}</td>
                              </tr>                                                          {% endif %} 
                              {% if product.manufacturer %} 
                              <tr class="product-card__features" style="font-size: 12px;">
                                <td style="text-align: right;"><b>Manufacturer : </b></td> <td> {{ product.manufacturer|e }} </td>
                              </tr>                                                          {% endif %}
                              <tr class="product-card__features" style="font-size: 12px;">
                                <td style="text-align: right;"><b>Preferred Location : </b></td><td> {{ product.location|e }}</td>
                              </tr>
                              <tr class="product-card__features" style="font-size: 12px;">
                               <td style="text-align: right;"><b> Qty Needed : </b> </td> <td>{{ product.qty_needed }}</td>
                            </tr>
                            </table>
                        </div>
                        <div class="product-card__footer">
                           <div class="product-card__prices">
                              <div class="product-card__price product-card__price--current"></div>
                           </div>
                         
                           <button class="product-card__addtocart-full " type="button" onclick="window.open('/contact/offer.php?id={{ product.online_id }}&amp;product_name={{ product.item|url_encode|e }}&wanted_id={{product.wanted_id}}', 'quoteWin', 'width=576,height=600,resizable,scrollbars');">
                           Sell to Us
                           </button>
                        </div>
                     </div>
                  </div>
                  {% endfor %}
                   <div class="products-view__pagination">
                          <nav aria-label="Page navigation example">{% include '/components/pagination.twig' with {inputs: {
                              page: page,
                              page_url: page_url,
                              pages: pages,
                          }} %}</nav>
                          <div class="products-view__pagination-legend">Showing {{ products|length }} of {{ total }} products</div>
                      </div>
                {% endif %}
               </div>
            </div> 
           
            </div>
            </div>
          </div>
        </div>
      </div>

    <div class="block-space block-space--layout--before-footer"></div>
  </div>
{% endblock %}
