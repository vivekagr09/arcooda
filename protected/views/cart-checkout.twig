{#
// inputs:
// - title:
// - description:
// - keywords:
// - payment_methods:
// - invoice:
// - invoice_charges:
// - invoice_courier_quotes:
// - invoice_products:
// - issues:
// - addresses:
#}

{% set global_page_title = inputs.title|default('Checkout') %}
{% set global_page_description = inputs.description|default('') %}
{% set global_page_keywords = input.keywords|default('') %}
{% set global_page_canonical = '/cart/checkout' %}
{% set global_page_breadcrumbs = [
{title : 'Home', url : '/'},
{title : global_page_title, url : global_page_canonical},
] %}
{% set global_current_cart_page = global_page_canonical %}
{% set member = inputs.member %}
{% set cart = cart() %}
{% set type =inputs.type %}
{% set invoice_discounts  = inputs.invoice_discounts %}
{% set payment_methods = inputs.payment_methods %}
{% set invoice = inputs.invoice %}
{% set invoice_charges = inputs.invoice_charges %}
{% set invoice_courier_quotes = inputs.invoice_courier_quotes %}
{% set invoice_products = inputs.invoice_products %}
{% set invoice_gifts = inputs.invoice_gifts %}
{% set issues = inputs.issues %}
{% set coupon = inputs.coupon %}
{% set country_list = countries() %}
{% set totalPrice = 0 %}
{% set user = user() %}
{% set addresses = inputs.addresses                                               %}
{% set member_couriers    = inputs.member_couriers                                                  %}
{% set courier_list    = inputs.courier_list                                                  %}
{% set shipingaddress = inputs.ship_addr                                               %}
{% set product = inputs.product %}
{% from '/macros/controls.twig' import input_check, input_radio %}

{% extends '/layouts/default.twig' %}



{% block site_body %}
{% include '/blocks/block-header.twig' with {inputs: {
title: 'Checkout',
breadcrumb: global_page_breadcrumbs,
}} %}

<div class="checkout block">

    <div class="container container-xl" style="max-width: 1300px;"><hr class="border-line" style="border: 1.5rem solid #1A79FF;">

        <form action="" method="post"
            onsubmit="document.getElementById('submit-btn').setAttribute('disabled', 'disabled')" id="payment-checkout-form">

            <div class="card checkout-cardBox mb-lg-0">
                <div class="row">
                    <div class="col">
                        <div class="card-body card-body--padding--2 top-card">
                            <h3 class="card-title" style="display: flex; justify-content: space-between;">
                                <span>Billing Details</span>
                                <i class="far fa-question-circle" data-toggle="tooltip" data-placement="top" data-html="true" title=""
                                    data-original-title="<div><b>We will make the invoice based on billing details. It will be our default contact</b></div>"
                                    aria-describedby="tooltip865053"></i>
                            </h3>
                            <div class="checkout-cardCont">
                               
                                {{ invoice.bill_address_full|raw|nl2br }}
                             </div>                                             
                            <div class="checkout-cardCont billing-card" style="margin-top: 0.2rem"y>
                                <div class="card-btnBox">
                                    <a href="javascript:void(0)" data-toggle="modal"
                                        data-target="#account-billing-add-modal" class="addAddress-btn">+&nbsp;CHANGE BILLING</a>
                                </div>
                                
                            </div>

                           
                        </div>
                        <div class="card-divider"></div>
                    </div>
                    {% if user.ship_addr %}
                    <div class="col">
                        <div class="card-body card-body--padding--2 top-card">
                            <h3 class="card-title" style="display: flex; justify-content: space-between;"><span>Shipping Details</span><i class="far fa-question-circle" data-toggle="tooltip" data-placement="top" data-html="true" title="" data-original-title="<div><b>We will send your order to this address. Please recheck the delivery address carefully as once goods are sent, its difficult or costly to make redirection changes.</b></div>" aria-describedby="tooltip865053"></i></h3>
                                <div class="checkout-table-Wrapper">
                                    <table class="table table-striped table-hover">
                                        
                                        {% set ship_num = 0 %}
                                        {% for key,ship in user.ship_addr %}
                                            <tr class="{{(ship.id != invoice.shipaddr_id)?'hide-address hide-address-class':''}}">
                                                <td style="width: 35px;"><input type="radio" name="checkout[shipaddr_id]" value="{{ ship.id }}"{{ (ship.id == invoice.shipaddr_id) ? ' checked="checked"' : '' }} /></td>
                                                
                                                <td>
                                                    <div class=""><b>{{ ((ship.company)?ship.company:ship.contact)|e }}</b></br>
                                                    {{ ship.address|e }} <br>
                                                    {{ ship.city|e }}, {{ ship.state|e }} {{ship.zip|e}}<br>
                                                              
                                                        {% for country in country_list %}
                                                        {% if ship.country == country.code %}
                                                        {{ country.name|e }}
                                                        {%endif%}
                                                        {% endfor %} 
                                                    </div><br>
                                                    <div class="">
                                                     {% if ship.phone %}Ph: {{ ship.phone|e }}{% endif %}
                                                     {% if ship.email %}<br />Email: {{ ship.email|e }}{% endif %}
                                                     {% if ship.name %}<br>Attn: {{ ship.name|e }}{% endif %}
                                                     </div>
                                                </td>
                                            </tr>
                                            {% set ship_num = ship_num + 1 %}
                                        {% endfor %}
                                    </table>
                                </div>
                                <div class="checkout-cardCont">
                                    <div class="card-btnBox" style="display: flex; justify-content: space-between; margin-top: -0.2rem">
                                        {% if ship_num>1 %}
                                        <a href="javascript:void(0)" class="show_less_more otherAddress-btn"style="">SHOW MORE</a>
                                        {% endif %}
                                        <a href="javascript:void(0)" data-toggle="modal" data-target="#account-shipping-add-modal" class="addAddress-btn" style="">+&nbsp;ADD NEW</a>
                                       
                                    </div>
                                </div>                    
                        </div>
                    </div>
                        {% endif %}
                    <div class="col">
                        <div class="card-divider"></div>
                        <div class="card-body card-body--padding--2 top-card" style="height: 90%;">
                            <h3 class="card-title" style="display: flex; justify-content: space-between;"><span>Notify Party</span> <i class="far fa-question-circle" data-toggle="tooltip" data-placement="top"
                                    data-html="true" title=""
                                    data-original-title="<div><b>If you have your own customs broker, or a department/company responsible to receive shipping information please add above. Only one company will be listed on any shipping documents.</b></div>"
                                    aria-describedby="tooltip865053"></i></h3>
                            {% if user.notify_parties %}
                            <div class="checkout-table-Wrapper">
                                <table class="table table-striped table-hover">
                                    {% for key,notify_party in user.notify_parties %}
                                    <tr
                                        class="{{(notify_party.default != 'y')?'hide-address hide-address-notify-class':''}}">
                                        <td style="width: 35px;"><input type="radio" name="checkout[notify][]"
                                                value="{{ notify_party.id }}" {{(notify_party.default=='y'
                                                )?'checked':''}} /></td>
                                        <td><div class=""><b>{{ notify_party.company_name|e }}</b></br>
                                            {{ notify_party.address|e }}<br>{{ notify_party.city|e }}, {{ notify_party.state|e }} {{notify_party.post_code|e}}<br>
                                                              
                                                        {% for country in country_list %}
                                                        {% if notify_party.country == country.code %}
                                                        {{ country.name|e }}
                                                        {%endif%}
                                                        {% endfor %} </div><br>
                                            <div class="">
                                            Ph: {{ notify_party.phone_no|e }}</br>
                                            Email: {{ notify_party.email|e }}<br>
                                           
                                        </div>
                                        </td>
                                        <!-- 
                                    <td> {% if notify_party.default == 'y' %}<div class="tag-badge tag-badge--theme">Default</div>{% endif %}</td> -->
                                    </tr>
                                    {% endfor %}
                                </table>
                            </div>
                            {% endif %}
                            <div class="checkout-cardCont">
                                <div class="card-btnBox" style="margin-top: 1rem; {{(user.notify_parties | length == 0)?'margin-top: 60%;':''}}">
                                    {% if user.notify_parties | length > 1 %}
                                    <a href="javascript:void(0)" class="otherAddress-btn show_less_more_notify">OTHER
                                        NOTIFY PARTY</a>
                                    {% endif %}
                                    <a href="javascript:void(0)" data-toggle="modal"
                                        data-target="#account-notify-add-modal" class="addAddress-btn" style="float:right;">+&nbsp;ADD
                                        NOTIFY
                                        PARTY</a>
                                    
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col">
                        <div class="card-divider"></div>
                        <div class="card-body card-body--padding--2">
                            <h3 class="card-title" style="display: flex; justify-content: space-between;"><span>Contacts</span> <i class="far fa-question-circle" data-toggle="tooltip" data-placement="top"
                                    data-html="true" title=""
                                    data-original-title="<div><b>Add your colleagues & family members to your account. We can send emails/tracking/updates to everyone listed in this section, but only you have access to you user account/login.</b></div>"
                                    aria-describedby="tooltip865053"></i></h3>
                            {% if user.contacts %}
                            <table class="table table-striped table-hover">
                                {% for contact in user.contacts %}
                                 

                                <tr>
                                    <td><input type="checkbox" name="checkout[contact][]" value="{{ contact.id }}"
                                            {{(contact.default=='y' )?'checked':''}} /></td>
                                    <td class= "d-flex justify-content-between"><span><b>{{ contact.name|e }} {{ contact.last_name|e }}</b> <em>({{ contact.email|e }})</em></span> {{(contact.default=='y')?'<div class="tag-badge tag-badge--theme">Default</div>':''}}</td> 
                                </tr>
                                {% endfor %}
                            </table>
                            {% endif %}
                            <div class="checkout-cardCont">
                                <div class="card-btnBox">
                                    <a href="javascript:void(0)" data-toggle="modal"
                                        data-target="#account-contact-add-modal" class="addAddress-btn">+&nbsp;ADD
                                        CONTACT</a>
                                </div>
                            </div>
                        </div>
                    </div>
                      {% if user.ship_addr %}
                    <div class="col">
                        <div class="card-body card-body--padding--2 accordion">
                            <h3 class="card-title">Other Instructions</h3>
                            <div class="checkout-cardCont">
                                <div class="form-group">
                                    <label for="checkout-ship-needs">My Shipping Instructions</label>
                                    <textarea id="checkout-ship-needs" class="form-control" rows="4"
                                        name="checkout[ship_needs]">{{ invoice.ship_needs|e }}</textarea>
                                </div>
                                <div class="form-group">
                                    <label for="checkout-proforma-purchaseorder">Purchase Order No. (If
                                        applicable)</label>
                                    <input type="text" name="checkout[proforma_purchaseorder]" class="form-control"
                                        id="checkout-proforma-purchaseorder"
                                        value="{{ invoice.proforma_purchaseorder|e }}" />
                                </div>
                            </div>
                        </div>

                        <div class="card-divider"></div>
                    </div>
                        {% endif %}
                    <div class="col">
                        <div class="card-body card-body--padding--2">
                            <h3 class="card-title" style="display: flex; justify-content: space-between;"><span>Coupons/Gift Voucher</span> <i class="far fa-question-circle" data-toggle="tooltip" data-placement="top"
                                    data-html="true" title=""
                                    data-original-title="<div><b>Please use your gift voucher/coupons. We often issue coupons during sales promotions  and social media.</b></div>"
                                    aria-describedby="tooltip865053"></i></h3>
                            <div class="checkout-cardCont">
                                <div class=" mx-2 d-flex" style="margin-top:1.45rem">
                                     {% if coupon.name %}
                                        <span style="color: green;">Code Applied!<br>
                                        {{ coupon.description }} <br> Code: {{ coupon.name }} <br><br><button style="width:8rem; background-color:#1A79FF; color: white" name="removecoupon" type="button" class="btn btn-sm btn-danger"  onclick="document.getElementById('removecoupon').submit();">Remove Coupon</button> </span>                                       
                                    {% else %}
                                       <div class="form-group mt-1" style="width: 73%">
                                            <input type="text"  class="form-control"  name="couponcode"  placeholder="Coupon Code" />  
                                       </div>
                                       <div class="form-group mt-1">
                                            <button name="couponaction"  type="button" class="btn btn-sm btn-primary mx-2 form-control" style="width:8rem; background-color:#1A79FF; color: white" value="applycoupon" onclick="document.getElementById('payment-checkout-form').submit();">Apply Coupon</button>                                      
                                           {% if coupon.coupon_avl == false %}<br><span style='color:red'>{{coupon.description}}</span>{% endif %}
                                        </div>
                                     {% endif %}
                                   
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% if invoice_courier_quotes |length > 0 %}
                <div class="row">
                    
                    <div class="card-divider"></div>
                    {% if user.ship_addr %}
                    <div class="col">
                        <div class="card-body card-body--padding--2 accordion">
                            <h3 class="card-title" style="display: flex; justify-content: space-between;"><span>Freight & Insurance</span> <i class="far fa-question-circle" data-toggle="tooltip" data-placement="top"
                                    data-html="true" title=""
                                    data-original-title="<div><b>Please check carefully the various freight options. If you are using your own freight courier account, please guide us what service you would like to use and whether we should insure your shipment.</b></div>"
                                    aria-describedby="tooltip865053"></i></h3>
                            <div class="row">
                                <div class="col checkout-cardCont">
                                    <div>
                                        <h4>FREIGHT : </h4>
                                    </div>
                                    <table class="table table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th>Service</th>
                                                <th>Price</th>
                                                <th>Transmit Time</th>
                                                <th>Tracking</th>
                                                <th>Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            
                                            <tr {{ invoice.shipping_method=='pickup'
                                                ? ' style="background-color:#b2d6ab" ' : '' }}>
                                                <td> <input type="radio" name="checkout[ship_number]" value="pickup" {{
                                                        invoice.shipping_method=='pickup'
                                                        ? ' checked="checked"' : '' }} />
                                                    Pickup</td>
                                                <td>N/A</td>
                                                <td>N/A</td>
                                                <td>N/A</td>
                                                <td>N/A</td>
                                                
                                                
                                            </tr>
                                            {% for courier_quote in invoice_courier_quotes|sort((a, b) => a.sell_priceus <=> b.sell_priceus) %}
                                                <tr {{ invoice.ship_number == courier_quote.ship_number ? 'style="background-color:#b2d6ab"' : '' }} >
                                                    <td><input type="radio" name="checkout[ship_number]" value="{{ courier_quote.ship_number }}"{{ invoice.ship_number == courier_quote.ship_number ? ' checked="checked"' : '' }} /> {{ courier_quote.name|e }}

                                                      {% if invoice.ship_discount > 0 %}
                                                      <br/>
                                                        <span class="product-warranty" style="color:red">
                                                            Total Fright {{invoice.ship_weight}} kg = ${{ courier_quote.sell_price|e }}  freight costs , less {{invoice.ship_weight_free}} kg (free freight for {{invoice.ship_weight_free}} kg) = ${{ invoice.ship_online }} 
                                                        </span>
                                                        <br/>
                                                        {% endif %}
                                                    </td>
                                                    <td><span class="{{courier_quote.is_free ? 'product__price product__price--old':''}}"}}>${{courier_quote.sell_priceus}}</span></td>
                                                    <td> {% if courier_quote.del_time %}  {{ courier_quote.del_time|e }}{% else %} N/A {% endif %}</td>
                                                    <td>{{(courier_quote.track == 'y')?'Yes':'No'}}</td>
                                                    <td>
                                                    {% if courier_quote.freight_notes != '' %}
                                                    <i class="far fa-question-circle" data-toggle="tooltip" data-placement="top" title="{{ courier_quote.freight_notes|e }}"></i>
                                                    {% else %} N/A {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                            {% if member_couriers|length > 0 %}
                                            {% for courier in member_couriers %}
                                            <tr {{ invoice.shipping_method == 'customer_forwarder' and invoice.ship_account_num == courier.account_num and invoice.ship_id ==courier.courier_id ? 'style="background-color:#b2d6ab"' : '' }}> 
                                                <td> <input type="radio" id="freight-need-own" name="checkout[ship_number]" class="" value="own_0" {{ invoice.shipping_method == 'customer_forwarder' and invoice.ship_account_num == courier.account_num and invoice.ship_id ==courier.courier_id ? ' checked="checked"' : '' }} data-account_num = "{{ courier.account_num }}" data-courier_name = "{{ courier.courier_name }}"
                                                data-courier_id = "{{ courier.courier_id }}" />
                                                    Use my Courier Account
                                                </td>
                                                <td colspan="3">{{ courier.courier_name }} ({{courier.account_num}})</td>
                                                <td>
                                                    <a href="#" class="addAddress-btn" data-toggle="modal" data-target="#account-Freight-add-modal">
                                                    +&nbsp;ADD YOUR FREIGHT ACCOUNT 
                                                    </a>
                                                
                                                </td>
                                                
                                            </tr>
                                              
                                             {% endfor %}
                                              <input type="hidden" name="checkout[own_account_num]" value="{{invoice.ship_account_num}}">
                                               <input type="hidden" name="checkout[own_courier_name]" value="{{member_courier.courier_name}}">
                                               <input type="hidden" name="checkout[own_courier_id]" value="{{invoice.ship_id}}">
                                            {% else %}
                                            <tr> <td colspan="4"> </td>
                                                    
                                                    <td><a href="#" class="addAddress-btn" data-toggle="modal" data-target="#account-Freight-add-modal">
                                                   +&nbsp;ADD YOUR FREIGHT ACCOUNT </a></td>
                                            </tr>
                                            {% endif %}
                                        </tbody>
                                    </table>
                                </div>
                                <div class="col checkout-cardCont">
                                    <div>
                                        <h4>INSURANCE : </h4>
                                    </div>
                                    <table class="table table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th>Price</th>
                                                
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr {{ invoice.terms_id != 4 ? 'style="background-color:#b2d6ab"' : ''}} >
                                                <td> <input type="radio" id="freight-need-coe" name="checkout[ship_insurance]" class="" value="n" {{invoice.terms_id!=4?'checked':''}}/> NO - Does not include insurance for this shipment<br><span class="comment"><i>Loss of goods, damage in transit and non-delivery is not covered</i></span></td>
                                                <td>$0.00 USD </td>
                                                
                                            </tr>
                                            {% if invoice.ship_insurance=='o' %}
                                            <tr {{ invoice.terms_id == 4 ? 'style="background-color:#b2d6ab"' : ''}} >
                                                <td><input type="radio" id="freight-need-ins" name="checkout[ship_insurance]" class="" value="y" {{invoice.terms_id==4?'checked':''}} /> YES - Include insurance for this shipment <br><span class="comment"><i>Covers damage in transit, loss of goods or non-delivery up to {{invoice.products_offer}} USD </i></span></td>
                                                <td>{{invoice.insurance_offer}} USD</td>
                                             {%  elseif invoice.ship_insurance=='y'  %}
                                                <td><i>Free insurance is available for this freight service<i></td>
                                             {% else %} 
                                             <td><span class="comment" style="color:red">No insurance available for this freight service. Please choose another freight option for insurance cover. </span></td>
                                             {% endif %}  
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <!--  <div class="form-group">
                        <input type="radio" id="freight-need-coe" name="checkout[freight_need]" class="" value="coe" />
                        <label class="ml-1" for="freight-need-coe">Please quote me freight costs for this order <b>WITHOUT</b> shipping insurance.</label>
                    </div>
                    <div class="form-group">
                        <input type="radio" id="freight-need-ins" name="checkout[freight_need]" class="" value="ins" />
                        <label class="ml-1" for="freight-need-ins">Please quote me freight costs for this order <b>WITH</b> shipping insurance.</label>
                    </div>
                    <div class="form-group">
                        <input type="radio" id="freight-need-own" name="checkout[freight_need]" class="" value="own" />
                        <label class="ml-1" for="freight-need-own">I want to use my own freight forwarder/courier for this order.</label>
                    </div> -->
                        </div>
                        <div class="card-divider"></div>
                    </div>
                        {% endif %}
                    
                </div>
                {% endif %}
                <div class="row">
                  
                        <div class="col">
                        <div class="card-body card-body--padding--2 accordion" style="margin-bottom: 0px;">
                            <h3 class="card-title">Payment Method</h3>
                            <div class="checkout-cardCont">
                                <ul class="payment-methods__list">
                                    {% for method in payment_methods %}
                                    <li
                                        class="payment-methods__item payment-methods__item{{ invoice.paymenttype_id == method.payment_method_id ? '--active' : '' }}">
                                        <label class="payment-methods__item-header">
                                            {{ input_radio({
                                            classes: 'payment-methods__item-radio',
                                            name: 'checkout[paymenttype_id]',
                                            value: method.payment_method_id,
                                            checked: invoice.paymenttype_id == method.payment_method_id,
                                            required : true
                                            }) }}
                                            <span class="payment-methods__item-title">{{ method.payment_method_name|e
                                                }}</span>
                                        </label>

                                        <div class="payment-methods__item-container">
                                            <div class="payment-methods__item-details text-muted" id="{{method.payment_method_id}}">{{
                                                markdown(method.payment_method_description) }}</div>
                                             {% if method.payment_method_id == 'EUR_BANK5' %}
                                             <i class="payment-methods__item-details text-muted" style="color: red!important;display: inline-block;">This EURO account can only accept payments in EURO. Payments made in USD to this account will be rejected by the bank.Please send ${{invoice.invoice_offereu}} Euro.  </i>
                                             {%  endif %}
                                        </div>
                                    </li>
                                    {% endfor %}
                                                                  
                                </ul>
                            </div>
                        </div>
                   
                        {#% endif %#}
                        {% if user.ship_addr %}
                       

                        {#
                        <div class="checkout-cardCont">
                            <div class="form-group">
                                <label for="checkout-customer-requests">My Order Requirements</label>
                                <textarea id="checkout-customer-requests" class="form-control" rows="4"
                                    name="checkout[customer_requests]">{{ invoice.customer_requests|e }}</textarea>
                            </div>
                        </div>
                        #}
                        <div class="card-body card-body--padding--2 accordion">
                            <div class="checkout-cardCont">
                                <div class="checkout__agree form-group">
                                    <div class="form-check">
                                        {{ input_check({
                                        classes: 'form-check-input',
                                        id: 'checkout-terms',
                                        required: true
                                        }) }}
                                        <label class="form-check-label" for="checkout-terms">I have read and agree to
                                            the
                                            <a onclick="window.open('/contact/terms.php?ship_insurance={{invoice.ship_insurance}}&terms_id={{invoice.terms_id}}', 'quoteWin', 'width=576,height=600,resizable,scrollbars');"
                                                style="cursor:pointer;color: #0064f0;">terms and conditions</a>
                                        </label>
                                    </div>
                                </div>
                                {% if invoice_products| length>0 %}
                                <button type="submit" class="btn btn-primary btn-xl btn-block" id="submit-btn"
                                    formaction="?action=submit_order" name="action" value="submit_order">Place
                                    Order</button>
                                {% endif %}
                            </div>
                        </div>
                        {% else %}
                        Please <a href="/account/shipping">add a shipping address</a> to your account to continue.
                    
                        {% endif %}
                    </div>
                        <div class="col">
                            <div class="card-body card-body--padding--2" style="border: 2px solid #dee2e6;">
                            <h3 class="card-title">Your Order</h3>
                            <div class="checkout-table-Wrapper checkout-cardCont">
                                <table class="checkout__totals">
                                    <thead class="checkout__totals-header">
                                        <tr>
                                            <th colspan="3">Product</th>
                                            <th colspan="2">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody class="checkout__totals-products">

                                        {% for item in invoice_products %} 
                                          
                                        {% if item.generic_code !='C39'%}
                                        <tr>

                                            <td style="width: 10%;"> 
                                            {% if item.product.images %}
                                                {% set image =
                                                item.product.images(item.colour_id,item.sub_product_id)[0] %}
                                                <a href="{{ item.product.url|e }}"><img src="{{ image(image, {size: 160})|e }}"
                                                        alt="{{ image.alt|e }}"
                                                        style="max-width: 96px;max-height: 96px;float:left;margin: 0 38px 0px 0;min-height: 75px;" /></a>
                                                {% endif %}

                                            </td>
                                            
                                            <td style="text-align: left;width: 50%;">
                                                <a href="{{ item.product.url|e }}">{{ item.product_name }}{% if
                                                    item.colour_id>0 %}
                                                    ({{item.product.Singlecolor_name(item.colour_id)}}) {% endif %}</a>
                                                    <br/><span class="product-warranty">Product Id : {{(item.generic == 'y')? item.generic_code : item.product_id }} {% if item.colour_id>0 and item.generic != 'y' %} {{item.colour_code}} {% endif %}</span>
                                                   {% if item.product.location %}
                                                   <br/><span class="product-warranty">Location : {{item.product.location}}</span>
                                                   {% endif %}
                                                   {% if item.product.warranty %}
                                                   <br/><span class="product-warranty">Warranty : {{item.product.warranty}}</span>
                                                   {# {% endif %} #}
                                                   {% endif %}
                                           
                                                {% if item.product.availability=='Pre Order' %}
                                                <div class="row" style="margin-bottom: 37px;">
                                                    <div class="col-md-12">
                                                       <span class="badge badge-warning" style="height:17px;">{{ item.product.availability|e }}
                                                       </span>
                                                   </div>
                                                   <div class="col-md-12 product-warranty">
                                                        <div><i>* 
                                                        {% if item.product.full_payment=='y' %}
                                                            Full payment needed 
                                                            {% if item.product.pre_order_close_date %}
                                                            by {{item.product.pre_order_close_date | date('jS F, Y')}}
                                                            {% endif %}
                                                        {% else %}
                                                        {{item.product.deposit_needed}} USD deposit needed, balance prior to shipping
                                                        {% endif %}
                                                        </i></div>
                                                        <div><i>* Estimated delivery date is {{item.product.arival_date}}</i></div>
                                                    </div>

                                                </div>
                                               
                                               
                                                 {% endif %}
                                                                                           
                                        
                                            </td>
                                            <td style="text-align: center;width: 10%;">×{{ item.product_qty }}</td>

                                            <td>

                                                {% if item.product_offer_total > 0 %}{{ item.product_offer_total| number_format(2, '.', ',') }} USD{%
                                                else %}
                                                   {{item.is_free == 'y' ? '$0.00' : 'Please Ask' }} 
                                                {% endif %}
                                            </td>
                                        </tr>
                                         {# gifts listing #}
                                    {% if invoice_gifts | length > 0 %}
                                    {% for gift in invoice_gifts %}
                                        {% if gift.product_id == item.product_id %}
                                        <tr>
                                            <td> 
                                            {% if gift.image_url %}
                                                <a href="{{ gift.url|e }}"><img src="{{ image(gift.image_url, {size: 160})|e }}"
                                                        alt=""
                                                        style="max-width: 96px;max-height: 96px;float:left;margin: 0 38px 0px 0;min-height: 75px;" /></a>
                                            {% endif %}

                                            </td>
                                            
                                            <td style="text-align: left;width: 60%;">
                                                <a href="{{ gift.url|e }}">{{ gift.name }}</a>
                                                <br />
                                                <span class="product-warranty">Product Id: {{ gift.id }}</span><br/>
                                                <span class="product-warranty">Warranty: {{ gift.warranty }}</span><br/>
                                                <span class="product-warranty">Location: {{ gift.location }}</span><br/>
                                            </td>
                                            <td>×{{ gift.qty }}</td>

                                            <td class="product__price product__price--old">{{ gift.price }} {{ invoice.invoice_currency|e }}</td>
                                        </tr>
                                        {% endif %}
                                    {% endfor %}
                                    {% endif %}
                                    {# end #}
                                        {% endif %}
                                        {% endfor %}

                                    </tbody>
                                    {% if invoice_discounts | length > 0 %}
                                      <tbody>
                                        {% for discount in invoice_discounts %}
                                        {% if discount.price_deducted > 0 %}
                                      <tr>
                                          <th colspan="3">{{discount.name == 'Monitor Bracket Discount' ? 'Monitor Bracket Discount' : 'Coupon Applied'}}</th>
                                          <td style="color: green ;">-{{ discount.price_deducted| round(2, 'floor') }} USD</td>
                                      </tr>
                                      {% endif %}
                                      {% endfor %}
                                      </tbody>
                                      {% endif %}
                                    {% if (invoice.shipping_method == 'customer_forwarder') and (member_couriers|length > 0) and (cart.items|length > 0) %}
                                    <tbody class="checkout__totals-shipping">
                                        <tr>
                                            <td></td>
                                            <td colspan="2">{{ invoice.ship_supplier_name|e }} (my account #{{ invoice.ship_account_num|e }})</td>
                                            <td>{{ invoice.ship_online }} USD</td>
                                        </tr>
                                    </tbody>
                                    {% elseif(invoice.shipping_method == 'other') %}
                                    <tbody class="checkout__totals-shipping">
                                        <tr>
                                            <td>{{ invoice.ship_number|e }}</td>
                                            <td>{{ invoice.ship_product_name|e }}</td>
                                            <td style="text-align: center; width: 10%;">×1</td>
                                            <td>{{ invoice.ship_online }} USD</td>
                                        </tr>
                                    </tbody>
                                    {% else %}
                                    {% endif %}
                                    <tbody class="checkout__totals-charges">
                                        
                                        {% for item in invoice_charges %}
                                        <tr>
                                            <td>C{{ item.charge_id }}</td>
                                            <td colspan="2" style="text-align: left;">{{ item.charge_name }}</td>
                                            <td>{{ item.charge_offer | number_format(2, '.', ',') }} USD</td>
                                        </tr>{% endfor %}
                                    </tbody>

                                     {% if coupon.value %}
                                    
                                     
                                      <tbody>
                                        <tr>
                                          <th colspan="2">Coupon Applied </th>
                                          <td colspan="2">- {{ coupon.value }} USD</td>
                                        </tr>
                                      </tbody>
                                      {% endif %}
                                    <tbody class="checkout__totals-subtotals"></tbody>
                                    <tfoot class="checkout__totals-footer">
                                        <tr>
                                            <th colspan="">Total</th>
                                            <input type="hidden" name="pay-amount" value="{{ invoice.invoice_offer }}">
                                            <td colspan="3">{{ invoice.invoice_offer }} USD</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                
            </div>
        </form>
    </div>
</div>

