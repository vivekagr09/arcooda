                        </div>
                         <div class="form-group">
                            <label for="{{ prefix }}-email">Email<span class="color-red">*</span><span class="color-red">*</span></label>
                            <input type="text" name="email" class="form-control" id="{{ prefix }}-email" value="{{ address.email|e }}" required/>
                        </div>
                        <div class="form-group">
                        <label for="{{ prefix }}-home-email">Set as Default</label>
                        <select  name="default" class="form-control" id="{{ prefix }}-home-email">
                        <option value="n" {{ (address.default =='n') ? ' selected="selected"' : '' }}>No</option>
                        <option value="y" {{ (address.default =='y') ? ' selected="selected"' : '' }}>Yes</option>
                        </select>
                    </div>
                    </div>
                    </div>
                <hr />
                <div class="form-group">
                    <input type="hidden" value="{{ address.id }}" name="id" />
                    <input type="hidden" value="add-notify-party" name="action" />
                    <input type="submit" class="btn btn-lg- btn-primary" value="Save" />
                </div>
            </form></div>
        </div></div></div>
{% set prefix = 'account-contact-add' %}
