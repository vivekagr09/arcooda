<script type="text/javascript">
function openMsgModel(orderid,invoiceid){
    $('#order_id').val(orderid);
    $('#invoice_id').val(invoiceid);
    $('#account-contact-modal').modal('show');
}
function openCancelModel(orderid,invoiceid){
    $('#cancel_order_id').val(orderid);
    $('#cancel_invoice_id').val(invoiceid);
    $('#account-cancel-modal').modal('show');
}
function functionadd(data){
/*e.preventDefault();*/
var price=$(data).parent().parent().parent().find('.product_price').val();
var qun=$(data).parent().parent().parent().find('.product-qty-input').val();
$(data).parent().parent().parent().find('.product_cost').html('$'+price*qun);

};
function functionsub(data){
var price=$(data).parent().parent().parent().find('.product_price').val();
var qun=$(data).parent().parent().parent().find('.product-qty-input').val();
$(data).parent().parent().parent().find('.product_cost').html('$'+price*qun);
};
document.addEventListener('DOMContentLoaded', function () {
    const tooltipTriggers = document.querySelectorAll('.tooltip-trigger');

    tooltipTriggers.forEach(function (tooltipTrigger) {
        const customTooltip = tooltipTrigger.nextElementSibling; // Select the corresponding tooltip

        tooltipTrigger.addEventListener('mouseover', function () {
            customTooltip.style.display = 'block'; // Show the tooltip
        });

        tooltipTrigger.addEventListener('mouseout', function () {
            customTooltip.style.display = 'none'; // Hide the tooltip
        });
    });
});
</script>
{% endblock %}