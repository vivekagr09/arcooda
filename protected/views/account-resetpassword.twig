{#
// inputs:
// - title:
// - description:
// - keywords:
// - alert:
// - issues:
// - result:
#}

{% set global_page_title           = inputs.title|default('Reset Password')       %}
{% set global_page_description     = inputs.description|default('')               %}
{% set global_page_keywords        = input.keywords|default('')                   %}
{% set global_page_canonical       = '/account/resetpassword'                     %}
{% set global_page_breadcrumbs     = [
	{title : 'Home',            url : '/'},
	{title : global_page_title, url : global_page_canonical},
] %}
{% set global_current_account_page = global_page_canonical                        %}

{% set alert     = inputs.alert                                                   %}
{% set issues    = inputs.issues                                                  %}
{% set result    = inputs.result                                                  %}

{% extends '/layouts/default.twig' %}

{% block site_body %}
    {% include '/blocks/block-header.twig' with {inputs: {
        title: 'Reset Password',
        breadcrumb: global_page_breadcrumbs,
    }} %}
    <div class="block"><div class="container"><div class="row justify-content-center"><div class="col-sm-10 col-md-8 col-lg-6 bg-white border p-sm-5"><form action="" method="post">
        {% if result %}<div class="alert alert-{{ result }}" role="alert">{{ alert|e }}</div>{% endif %}
        <div class="form-group">
            <label for="account-resetpassword-new-password">New Password*</label>
            <input autocomplete="new-password" class="form-control{{ (issues['new-password']) ? ' is-invalid' : '' }}" id="newPassword" name="new-password" minlength="8" placeholder="Enter Password" required="required" type="password" />
            {% if issues['new-password'] %}<span class="invalid-feedback"><strong>{{ issues['new-password'] }}</strong></span>{% endif %}
            <div id="password-strength-status"></div>
        </div>
        <div class="form-group">
            <label for="account-resetpassword-confirm-password">Confirm Password*</label>
            <input autocomplete="new-password" class="form-control{{ (issues['confirm-password']) ? ' is-invalid' : '' }}" id="account-resetpassword-confirm-password" minlength="8" name="confirm-password" placeholder="Repeat Password" required="required" type="password" />
            {% if issues['confirm-password'] %}<span class="invalid-feedback"><strong>{{ issues['confirm-password'] }}</strong></span>{% endif %}
        </div>
		<div class="form-group text-center">
            <input type="hidden" name="action" value="update" />
            <button class="btn btn-primary mt-3">Update Password</button>
        </div>
	</form></div></div></div></div>
    {% include '/blocks/block-space.twig' with {inputs: {
		layout: 'before-footer',
	}} %}
{% endblock %}
