{% set global_page_title       = inputs.page_title %}
{% set global_page_description = inputs.page_description %}
{% set global_page_keywords    = inputs.page_keywords %}
{% set global_page_canonical   = inputs.page_canonical %}
{% set global_page_breadcrumbs = inputs.page_breadcrumbs %}

{% set products   = inputs.products %}
{% set helpText = inputs.helpText %}
{% set sortby = inputs.sortby %}
{% set prodWidth = inputs.prodWidth %}


{% block site_body %}
<style>
  .spec-row {
    display: flex;
    width: 100%;
    margin-bottom: 6px;
  }

  .spec-label {
    width: 33%;
    font-weight: 500;
  }

  .spec-values {
    width: 67%;
    display: flex;
    gap: 15px; /* spacing between cm and inch */
  }

  .spec-values div {
    white-space: nowrap;
  }
    .spec-table td {
    padding: 4px 6px;
    white-space: nowrap; /* prevents "Widt h" problem */
    font-size: 12px;
  }

  .label-col {
    width: 60px;  /* fixes Width/Height column */
    font-weight: 600;
  }

  .cm-col {
    width: 70px;  /* fixes cm column */
  }

  .inch-col {
    width: 70px; /* fixes inch column */
  }
</style>
    <table border="1" cellpadding="4" cellspacing="0" width="100%">
        <tr>
            <td width="40mm" style="word-wrap: break-word; white-space: normal;">Price</td>
            {% for product in products %}
                <td width="{{prodWidth}}mm" style="word-wrap: break-word; white-space: normal;">{{ product.price.format('[symbol_e]<span class="product-price-update">[price_inc_gst_e]</span> <span style="font-size:60%" id="labelUSD">[currency_e]</span>')|currency }}
                       
                </td>
            {% endfor %}
        </tr>
        <tr>
            <td width="40mm" style="word-wrap: break-word; white-space: normal;">Monitor Size</td>
            {% for product in products %}
                <td width="{{prodWidth}}mm" style="word-wrap: break-word; white-space: normal;">{{product.productGetOptionListData('monitor_size')[product.monitoOptions.monitor_size] }}
                </td>
            {% endfor %}
        </tr>
        <tr>
            <td width="40mm" style="word-wrap: break-word; white-space: normal;">Monitor Resolution </td>
            {% for product in products %}
                <td width="{{prodWidth}}mm" style="word-wrap: break-word; white-space: normal;">{{product.productGetOptionListData('monitor_resolution')[product.monitor_resolution] }}
                </td>
            {% endfor %}
        </tr>
        <tr>
            <td width="40mm" style="word-wrap: break-word; white-space: normal;">Monitor Aspect Ratio </td>
            {% for product in products %}
                <td width="{{prodWidth}}mm" style="word-wrap: break-word; white-space: normal;">{{product.productGetOptionListData('monitor_ratio')[product.monitor_ratio] }}
                </td>
            {% endfor %}
        </tr>
        <tr>
            <td width="40mm" style="word-wrap: break-word; white-space: normal;">Software Aspect Ratio </td>
            {% for product in products %}
                {% set aspect_ratio_software = product.monitoOptions.aspect_ratio_software|split(',') %}
                <td width="{{prodWidth}}mm" style="word-wrap: break-word; white-space: normal;">{% for ratio in aspect_ratio_software %}{{product.productGetOptionListData('monitor_ratio')[ratio] }}{% if not loop.last %}, {% endif %}{% endfor %}
                </td>
            {% endfor %}
        </tr>
         <tr>
            <td width="40mm" style="word-wrap: break-word; white-space: normal;"> Inputs</td>
            {% for product in products %}
           <td width="{{prodWidth}}mm">
                {%- set inputs = [] -%}

                {%- if product.monitoOptions.input_vga > 0 -%}
                    {%- set inputs = inputs|merge([product.monitoOptions.input_vga ~ ' * VGA']) -%}
                {%- endif -%}

                {%- if product.monitoOptions.input_hdmi > 0 -%}
                    {%- set inputs = inputs|merge([product.monitoOptions.input_hdmi ~ ' * HDMI']) -%}
                {%- endif -%}

                {%- if product.monitoOptions.input_dvi > 0 -%}
                    {%- set inputs = inputs|merge([product.monitoOptions.input_dvi ~ ' * DVI']) -%}
                {%- endif -%}

                {%- if product.monitoOptions.input_displayport > 0 -%}
                    {%- set inputs = inputs|merge([product.monitoOptions.input_displayport ~ ' * DisplayPort']) -%}
                {%- endif -%}

                {%- if product.monitoOptions.input_usb > 0 -%}
                    {%- set inputs = inputs|merge([product.monitoOptions.input_usb ~ ' * USB (type A)']) -%}
                {%- endif -%}

                {%- if product.monitoOptions.input_usb_type_c > 0 -%}
                    {%- set inputs = inputs|merge([product.monitoOptions.input_usb_type_c ~ ' * USB (type C)']) -%}
                {%- endif -%}

                {{- inputs|join('<br>')|trim|raw -}}
                </td>
                        {% endfor %}
        </tr>
        <tr>
            <td width="40mm" style="word-wrap: break-word; white-space: normal;">Panel Type</td>
