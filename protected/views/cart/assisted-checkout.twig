{#
// inputs:
// - page_title:
// - page_description:
// - page_keywords:
// - page_canonical:
// - page_breadcrumbs:
#}

{% set global_page_title       = inputs.page_title|default('Assisted Checkout') %}
{% set global_page_description = inputs.page_description %}
{% set global_page_keywords    = inputs.page_keywords %}
{% set global_page_canonical   = inputs.page_canonical %}
{% set global_page_breadcrumbs = inputs.page_breadcrumbs %}

{% set model = inputs.model %}
{% set comment = inputs.comment %}

{% extends '/layouts/popup.twig' %}

{% block site_body %}
<script type="text/javascript">
//<![CDATA[
$(function() {
	$("#assistance_form").submit(function() {
		var check_list = {
            "cont_name"    : "your name",
            "cont_email"   : "a valid email address",
            "cont_country" : "your country",
            "cont_subject" : "a subject that best describes the issue",
            "cont_msg"     : "some comments about the issue that has occurred",
        };
		for (var k in check_list) {
			var $elem = $("[name='" + k + "']");
			if ($elem.length > 0 && ($elem.val() == "" || $elem.val() == "Type your comments here")) {
				alert("Please enter " + check_list[k] + " before continuing.");
				$elem.focus();
				return false;
			}
		}
	});
});
//]]>
</script>

{#% include '/blocks/block-header.twig' with {inputs: {
	title: 'Assisted Checkout',
	breadcrumb: global_page_breadcrumbs,
}} %#}

<div class="block">
	<div class="container">
	
<form action="" method="post" target="_top" id="assistance_form"{{ model.errors ? ' class="was-validated"' : '' }} onsubmit="return validateForm(this);">

{% set ac_prefix = 'section-assisted-checkout ' %}

<input type="hidden" name="action" value="do_add" />
<input type="hidden" name="honeypot" value="" />

<dl>
{% for k,v in model.errors %}
<dt>{{k|e}}</dt>
<dd>{{v|e}}</dd>
{% endfor %}
</dl>

<div class="card">
	<div class="card-header"><h2 class="card-title mb-0">Assisted Checkout</h2></div>
	<div class="card-body">
		<p>{#If you are having any issues ordering online, #}Please fill in the table below. One of our sales representatives will be in contact with you as soon as possible.</p>
		<div class="mb-3 row">
			<label for="givenName" class="col-md-3 col-xl-2 col-form-label">First Name</label>
			<div class="col-md-9 col-xl-10"><input id="givenName" name="givenName" type="text" class="form-control" autocomplete="section-assisted-checkout given-name" value="{{ model.givenName|e }}" required="required" /></div>
		</div>
		<div class="mb-3 row">
			<label for="familyName" class="col-md-3 col-xl-2 col-form-label">Last Name</label>
			<div class="col-md-9 col-xl-10"><input id="familyName" name="familyName" type="text" class="form-control" autocomplete="section-assisted-checkout family-name" value="{{ model.familyName|e }}" required="required" /></div>
		</div>
		<div class="mb-3 row">
			<label for="email" class="col-md-3 col-xl-2 col-form-label">Email</label>
			<div class="col-md-9 col-xl-10"><input id="email" name="email" type="email" class="form-control" autocomplete="section-assisted-checkout email" value="{{ model.email|e }}" required="required" /></div>
		</div>
		<div class="mb-3 row">
			<label for="country" class="col-md-3 col-xl-2 col-form-label">Country</label>
			<div class="col-md-9 col-xl-10"><select id="country" name="country" class="form-control" autocomplete="section-assisted-checkout country" required="required">
				<option value="">-- Please Choose your Country --</option>
				{% for k, v in model.countries %}<option value="{{ k|e }}"{{ (k == model.country) ? ' selected="selected"' : '' }}>{{ v|e }}</option>{% endfor %}
			</select></div>
		</div>
		<div class="mb-3 row">
			<label class="col-md-3 col-xl-2 col-form-label">Items Ordered</label>
			<div class="col-md-9 col-xl-10">{% include '/cart/order-summary.twig' with {inputs : {
				'invoice'          : model.invoice,
				'invoice_products' : model.products,
				'invoice_charges'  : model.charges,
			}} %}</div>
		</div>
{#
		<div class="mb-3 row">
			<label for="cont_subject" class="col-md-3 col-xl-2 col-form-label">Issue Encountered</label>
			<div class="col-md-9 col-xl-10"><select id="cont_subject" name="cont_subject" class="form-control">
				<option value="">-- Please Choose an Issue --</option>
				{% for k, v in problem_list %}<option value="{{ k|e }}">{{ v|e }}</option>{% endfor %}
			</select></div>
		</div>
		<div class="mb-3 row">
			<label for="cont_msg" class="col-md-3 col-xl-2 col-form-label">Comments</label>
			<div class="col-md-9 col-xl-10"><textarea id="cont_msg" name="cont_msg" class="form-control" rows="3" cols="40" onkeyup="textareaAutoSize(this,1,3,21);" placeholder="Type your comments here"></textarea></div>
		</div>
		{% if (array_key_exists("recaptcha_public", $_GLOBALS["site_settings"]) && moduleLoad('recaptcha')) %}
			{% set hash = md5($_SERVER['REMOTE_ADDR'] . (array_key_exists('HTTP_USER_AGENT', $_SERVER)) ? $_SERVER['HTTP_USER_AGENT'] : '') %}
			<div class="mb-3 row">
				<label class="col-md-3 col-xl-2 col-form-label">Verification</label>
				<div class="col-md-9 col-xl-10">
					<input type="hidden" name="darkweb_hash" value="{{ hash|e }}" />
					<div class="g-recaptcha" data-sitekey="{{ $_GLOBALS['site_settings']['recaptcha_public']|e }}"></div>
					<script type="text/javascript" src="https://www.google.com/recaptcha/api.js"></script>
				</div>
			</div>
		{% endif %}
#}		
		<div class="mb-3 row">
			<label for="cont_msg" class="col-md-3 col-xl-2 col-form-label">Comments</label>
			<div class="col-md-9 col-xl-10"><textarea id="quote_request_comment" name="checkout[customer_requests]" class="form-control" rows="3" cols="40" onkeyup="textareaAutoSize(this,1,3,21);" placeholder="Type your comments here">{{comment}}</textarea></div>
		</div>
		<div class="mb-3 row">
			<div class="col-md-9 col-xl-10 text-center">
	            <div class="g-recaptcha" data-sitekey="6Ld2WYEnAAAAAJL089eYW4Yl-JLJ35x7M3kbTNb6"></div>
	        </div>
        </div>
		<div class="mb-3 row">
			<label class="col-md-3 col-xl-2 col-form-label"></label>
			<div class="col-md-9 col-xl-10 text-center">
		        <button type="submit" class="btn btn-warning btn-lg btn-block" id="send-btn" name="action" value="send">Send us your inquiry</button>
			</div>
		</div>
	</div>
</div>

</form>

	</div>
</div>
<!-- script for ReCaptch  -->
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script>
	function validateForm(form) {
            var error = false;
            var response = grecaptcha.getResponse();
            if(response.length == 0)
            {
                alert("Please verify you are not a robot");
                error = true;
            }
            //end

            return (!error);
        }
</script>
<!-- end  -->
{% endblock %}

