{#
// inputs:
// - page_title:
// - page_description:
// - page_keywords:
// - page_canonical:
// - page_breadcrumbs:
#}

{% set global_page_title       = inputs.page_title|default('Thank You') %}
{% set global_page_description = inputs.page_description %}
{% set global_page_keywords    = inputs.page_keywords %}
{% set global_page_canonical   = inputs.page_canonical %}
{% set global_page_breadcrumbs = inputs.page_breadcrumbs %}

{% set invoice_number = inputs.invoice_number %}

{% extends '/layouts/default.twig' %}

{% block site_body %}
	{#% include '/blocks/block-header.twig' with {inputs : {
		title      : 'Thank You',
		breadcrumb : global_page_breadcrumbs,
	}} %#}
    {% include '/blocks/block-space.twig' with {inputs : {
		layout : 'after-header',
	}} %}
	<div class="block"><div class="container"><div class="order-success__body"><div class="order-success__header" style="padding:0 0 52px;">
		<div class="order-success__icon" style="text-align:center;display:table;">
			<div class="row">
				<svg width="100" height="100"><path d="M50,100C22.4,100,0,77.6,0,50S22.4,0,50,0s50,22.4,50,50S77.6,100,50,100z M50,2C23.5,2,2,23.5,2,50s21.5,48,48,48s48-21.5,48-48S76.5,2,50,2z M44.2,71L22.3,49.1l1.4-1.4l21.2,21.2l34.4-34.4l1.4,1.4L45.6,71C45.2,71.4,44.6,71.4,44.2,71z"></path></svg>
				<div style="text-align:left;margin-left:20px;margin-top:-17px;">
					<h1 class="order-success__title">Thank You</h1>
					<div class="order-success__subtitle">Your inquiry has been received</div>
				</div>
			</div>
		</div>
		{% if invoice_number %}
		<div class="order-success__icon row" style="text-align:center;display:table;margin-top:10px;">
			<p><span style="font-size:22px;"><b>Reference </b>:</span> <span style="color:#5ac144;font-weight:600;font-size:22px;">QAR#{{ invoice_number|e }}</span></p>
		</div>
		{% endif %}
		<div class="order-success__icon row" style="text-align:center;display:table;margin-top:10px;">
			<p>Thank you for your inquiry. We will reply as soon as possible, However for any urgent matters, Please call our office and quote the above refrence number.</p>
		</div>
		<div class="order-success__actions"><a href="/" class="btn btn-sm btn-secondary">Go To Homepage</a> <a href="/account/orders" class="btn btn-primary">My Account</a></div>
	</div></div></div></div>
	{% include '/blocks/block-space.twig' with {inputs : {
        layout : 'before-footer',
    }} %}
{% endblock %}
