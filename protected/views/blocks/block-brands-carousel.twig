{#
// inputs:
// - layout: string - one of [columns-8-full, columns-7-sidebar] (default: columns-8-full)
// - brands: [image, title, url]
#}

{% set layout = inputs.layout|default('columns-8-full') %}
{% set root_classes = classnames('block block-brands block-brands--layout--' ~ layout) %}

{% set title  = inputs.title %}
{% set layout = inputs.layout %}
{% set groups = inputs.groups|default([]) %}
{% set brands = inputs.brands %}

{% set root_classes = classnames('block block-posts-carousel', {
    'block-posts-carousel--layout--grid': layout == 'grid',
    'block-posts-carousel--layout--list': layout == 'list',
}) %}

<div class="{{ root_classes }}" data-layout="{{ layout }}"><div class="container">
	{% include '/components/section-header.twig' with {inputs: {
		title  : title,
		arrows : true,
		groups : groups,
	}} %}

	<div class="block-posts-carousel__carousel"><div class="owl-carousel">
		{% for brand in brands %}
			<div class="block-posts-carousel__item">

				{% if brand.url %}
					<a class="block-brands__item-link" href="{{ brand.url|e }}" title="{{ brand.name|e }}" target="_blank">
						<img src="{{ image(brand.image, {width : 262, height : 148})|e }}" alt="{{ brand.image.alt|e }}" loading="lazy"/>
					</a>
				{% else %}
					<div class="block-brands__item-link">
						<img src="{{ image(brand.image, {width : 262, height : 148})|e }}" alt="{{ brand.image.alt|e }}" title="{{ brand.name|e }}" loading="lazy"/>
					</div>
				{% endif %}

			</div>
		{% endfor %}
	</div></div>
</div></div>
