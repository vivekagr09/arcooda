<script>
function addclass(x) {
    $(x).find('.icn-hvr').addClass('ccn_display_none');
}

function removeclass(x) {
    $(x).find('.icn-hvr').removeClass('ccn_display_none');
  //x.closest( ".icn-hvr" );
}
