{#
// inputs:
// - layout: string - one of [top-strip, bottom-strip] (default: top-strip)
#}

{% set layout = inputs.layout|default('top-strip') %}
{% set root_classes = classnames('block-features block', 'block-features--layout--' ~ layout) %}

{% set icons = inputs.icons %}
<div class="{{ root_classes }}">
    <div class="container">
        <ul class="block-features__list">

			{% for icon in icons %}
				<li class="block-features__item">
                    {% if (icon.descriptionval != '') %}
                    <a href="{{ icon.url }}.html" style="color: #fff;height: 100%;display: inline-block;overflow-y: scroll;" class="icn-hvr ccn_display_none">
                     {{ icon.descriptionval }}
                    </a>
                    {% endif %}
					<div class="block-features__item-icon">
						{% if (icon.description != '') %} <a href="{{ icon.url }}.html"> {% endif %}
						{{ icon.image.html({"width":"48"}) }}
						{% if (icon.description != '') %} </a> {% endif %}
					</div>
					<div class="block-features__item-info">
						<div class="block-features__item-title text-dark">
							{% if (icon.description != '') %} <a class="text-dark" href="{{ icon.url }}.html"> {% endif %}
							{{ icon.name }}
							{% if (icon.description != '') %} </a> {% endif %}
						</div>

						<div class="block-features__item-subtitle text-muted">
							{% if (icon.description != '') %} <a class="text-muted" href="{{ icon.url }}.html"> {% endif %}
							{{ icon.text }}
							{% if (icon.description != '') %} </a> {% endif %}
						</div>
					</div>
				</li>
			{% endfor %}

